@startuml
interface CrudHandler {
    fun getAll(ctx: Context)
    fun getOne(ctx: Context, resourceId: String)
    fun create(ctx: Context)
    fun update(ctx: Context, resourceId: String)
    fun delete(ctx: Context, resourceId: String)
}

class DonacionesController implements CrudHandler {
  + void getAll(@NotNull Context contexto)
  + void getOne(@NotNull Context contexto, @NotNull String idDonante)
  + void create(@NotNull Context contexto)
  + void update(Context contexto, @NotNull String idDonante)
  + void delete(@NotNull Context contexto, @NotNull String idDonante)
  + void iniciarTraslado (Context context)
  + void marcarComoFallida(Context context)
  + void marcarComoEntregada(Context context)
  + void almacenarEnDeposito(Context context)
  + void alistarParaEntregar(Context contexto)
  + void vencer(Context contexto)
  + void getListasParaEntregar(Context ctx)
  + List<DonacionIndependiente> getListasParaEntregar()
  + List<DonacionIndependiente> getAsignadas()
  + List<DonacionIndependiente> getPendientesDeRevision()
  + void getHistorialDeCambiosDeEstado(Context contexto)
}

class DonacionesRepositoryConPersistencia<<Singleton>> {
