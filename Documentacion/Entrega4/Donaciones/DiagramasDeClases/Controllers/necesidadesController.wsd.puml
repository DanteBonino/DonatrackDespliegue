@startuml
interface CrudHandler {
    fun getAll(ctx: Context)
    fun getOne(ctx: Context, resourceId: String)
    fun create(ctx: Context)
    fun update(ctx: Context, resourceId: String)
    fun delete(ctx: Context, resourceId: String)
}

class NecesidadesController implements CrudHandler {
 + void getAll(@NotNull Context contexto)
 + void getOne(@NotNull Context contexto, @NotNull String necesidadId)
 + void create(@NotNull Context contexto)
 + void update(Context contexto, @NotNull String necesidadId)
 + void delete(@NotNull Context contexto, @NotNull String necesidadId)
}

class BeneficiariosRepositoryConPersistencia <<Singleton>> {
  + EntidadBeneficiaria findById(String id)
}

class EntidadBeneficiaria {
  + void eliminarNecesidad(String idNecesidad)
  + void refrescarNecesidadParcial(String idNecesidad, @NotNull   DatosNecesidad datos)
  + void agregarNecesidad(Necesidad unaNecesidad)
  +  Necesidad buscarNecesidadPorId(String idNecesidad)
}

abstract class Necesidad {

}

NecesidadesController  ..> BeneficiariosRepositoryConPersistencia
BeneficiariosRepositoryConPersistencia ..> EntidadBeneficiaria
EntidadBeneficiaria  --> "*" Necesidad

