@startuml

interface Actualizable<D> {
  + default void refrescarParcial(D datos)

  + void actualizarDesde(D datos, boolean pacial);

}

abstract class EntidadBase <<MappedSuperclass>> {
  + String getIdDominio()

  + boolean esLaMismaEntidad(String id)

  + Long getId()

}

interface Eliminable {
  + boolean estaEliminado();
  + void marcarComoEliminado();
}


abstract class Necesidad <<Entity>> extends EntidadBase implements Actualizable<DatosNecesidad> {
  + estaEliminado
  + boolean estaEliminado();
  + void marcarComoEliminado();
  + Boolean estaSatisfecha();
  + Integer cantidadRecibida()
  + Integer cantidadRequerida()
  + Boolean estaActiva()
  + Set<ReciboDeDonacion> bienesRecibidosActuales()
  # <<abstract>> boolean condicionDeActualidad(ReciboDeDonacion unBienRecibido)
  + void recibirBien(DonacionIndependiente unaDonacion)
  + int cantidadDeDonacionesRecibidasDespuesDe(LocalDate unaFecha)
  + abstract TipoNecesidad getTipo();
  # boolean matcheaConBienRequerido(ReciboDeDonacion recibo)
  + void actualizarDesde(DatosNecesidad datos, boolean pacial)
}


class Bien <<Embeddable>> {
 - descripcion
 - foto
 - cantidad
 + Boolean esDe(SubCategoria unaSubCategoria)
 + Boolean seAgrupaPor(SubCategoria unaSubCategoria)
 + Integer getCantidad()
 + Boolean esIgualA(Bien otroBien
}

class SubCategoria  <<Embeddable>> {
 - String tipoCategoria}
 - LocalDate vencimiento
 - String tipoCategoria
 + Categoria getCategoria()
}

enum NombreSubCategoria {
 FIDEOSSECOS, PANTALON, REMERA, PELOTA
}

Necesidad  ..|> Eliminable

enum EstadoDeUso {
    USADO, NUEVO
}

interface Categoria {
  + Object valorDeAgrupamiento();

  + default Boolean esLaMisma(Categoria otraCategoria)
}

class NoPerecedero implements Categoria {

  + Object valorDeAgrupamiento()

  + EstadoDeUso getEstado()
}

NoPerecedero --> EstadoDeUso

class Perecedero implements Categoria {
  - LocalDate fechaDeVencimiento
  + Object valorDeAgrupamiento()

  + LocalDate getVencimiento()
}



Necesidad --> Bien: "bienRequerido"
Necesidad --> "*" ReciboDeDonacion
Bien --> SubCategoria
SubCategoria --> NombreSubCategoria
SubCategoria --> EstadoDeUso
SubCategoria ..> Categoria

class ReciboDeDonacion <<Embeddable>> {
  - LocalDate fechaDeRecepcion
  + boolean esPosteriorA(LocalDate unaFecha)
  + int getCantidad()
  + Bien getBienDonado()
}

class DonacionIndependiente <<Entity>> {
  + int getCantidad()
  + Bien getBienDonado()
}

note top of DonacionIndependiente
  Simplificada por una cuestión de tamaño del diagrama,
  ver su propio diagrama
end note

DonacionIndependiente --> Bien

ReciboDeDonacion --> DonacionIndependiente

class NecesidadExtraordinaria <<Entity>> extends Necesidad {
  + TipoNecesidad getTipo()
  # boolean condicionDeActualidad()
}

class NecesidadRecurrente <<Entity>> extends Necesidad {
 - Period periodo
 - LocalDate inicioPeriodoActual

 + TipoNecesidad getTipo()
 #  boolean condicionDeActualidad()
 + void actualizarDesde(DatosNecesidad datos, boolean pacial)
}

@enduml