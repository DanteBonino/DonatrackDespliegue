<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence
    http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd"
             version="2.0">

    <persistence-unit name="simple-persistence-unit" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>domain.Camion</class>
        <class>domain.Posicion</class>
        <class>domain.Ruta</class>
        <class>domain.EstadoRuta</class>
        <class>domain.Entrega</class>
        <class>domain.EstadoEntrega</class>
        <class>domain.EstadoHistorico</class>
        <class>domain.Direccion</class>
        <class>domain.Calle</class>
        <exclude-unlisted-classes>false</exclude-unlisted-classes>
        <properties>
            <!-- Driver y dialecto -->
            <property name="hibernate.connection.driver_class" value="org.postgresql.Driver"/>
            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.PostgreSQL10Dialect"/>

            <property name="hibernate.archive.autodetection"
                      value="class"/>

            <property name="hibernate.default_schema"
                      value="logistica"/>


            <!-- Ajustes adicionales -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="use_sql_comments" value="true"/>
        </properties>

    </persistence-unit>

</persistence>