{{#partial "head"}}
<style>
  /* Más aire para la página */
  .hero {
    padding-top: 7rem;
    padding-bottom: 7rem;
  }

  .seccion {
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  .seccion-cta {
    padding-top: 5rem;
    padding-bottom: 5rem;
  }
</style>
{{/partial}}

{{#partial "contenido"}}

<!-- ==================== HERO: Proposito y objetivos ==================== -->
<section class="bg-primary text-white hero">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-9 text-center">
        <h1 class="display-4 fw-bold mb-4">DonaTrack</h1>
        <p class="lead mb-3">{{subtitulo}}</p>
        <p class="mb-5">{{descripcion}}</p>

        <!-- Accesos requeridos por enunciado -->
          <div class="d-flex flex-wrap gap-4 justify-content-center">
              <a href="/registro" class="btn btn-light btn-lg fw-semibold">
                  <i class="bi bi-person-plus me-2"></i>Registrarme
              </a>
              <a href="/login" class="btn btn-outline-light btn-lg">
                  <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar sesión
              </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ==================== PROPOSITO Y OBJETIVOS ==================== -->
<section class="seccion">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="fw-bold mb-4">Nuestro propósito</h2>
      <p class="text-muted col-lg-8 mx-auto">
        DonaTrack es la plataforma de UTN Solidaria para organizar, registrar y monitorear
        donaciones de bienes materiales desde su recepción en el depósito hasta su entrega
        a entidades beneficiarias, fortaleciendo la confianza de personas donantes y beneficiarias.
      </p>
    </div>

      <div class="row g-5 text-center">
          <div class="col-md-6 col-lg-3">
              <i class="bi bi-eye fs-1 text-primary"></i>
              <h5 class="mt-3 mb-3">Transparencia</h5>
              <p class="text-muted small mb-0">Seguí cada donación a través de estados verificables.</p>
          </div>
          <div class="col-md-6 col-lg-3">
              <i class="bi bi-truck fs-1 text-primary"></i>
              <h5 class="mt-3 mb-3">Trazabilidad</h5>
              <p class="text-muted small mb-0">Monitoreá el recorrido de cada donación hasta su entrega final.</p>
          </div>
          <div class="col-md-6 col-lg-3">
              <i class="bi bi-people fs-1 text-primary"></i>
              <h5 class="mt-3 mb-3">Confianza</h5>
              <p class="text-muted small mb-0">Conectamos donantes con entidades beneficiarias de forma clara.</p>
          </div>
          <div class="col-md-6 col-lg-3">
              <i class="bi bi-heart fs-1 text-primary"></i>
              <h5 class="mt-3 mb-3">Impacto social</h5>
              <p class="text-muted small mb-0">Cada donación llega a quien más lo necesita.</p>
          </div>
      </div>
  </div>
</section>

<!-- ==================== COMO FUNCIONA ==================== -->
<section class="bg-light seccion">
  <div class="container">
    <h2 class="text-center fw-bold mb-5">¿Cómo funciona?</h2>

      <div class="row g-5 text-center">
          <div class="col-md-4">
              <div class="badge bg-primary rounded-circle mb-4" style="width:48px;height:48px;line-height:32px;font-size:1.25rem;">1</div>
              <i class="bi bi-box-seam fs-2 text-primary d-block mb-3"></i>
              <h5 class="mb-3">Donás</h5>
              <p class="text-muted small mb-0">Registrás tu donación y la acercás a nuestro depósito.</p>
          </div>
          <div class="col-md-4">
              <div class="badge bg-primary rounded-circle mb-4" style="width:48px;height:48px;line-height:32px;font-size:1.25rem;">2</div>
              <i class="bi bi-diagram-3 fs-2 text-primary d-block mb-3"></i>
              <h5 class="mb-3">Asignamos</h5>
              <p class="text-muted small mb-0">Nuestros algoritmos asignan la donación a la entidad beneficiaria más adecuada.</p>
          </div>
          <div class="col-md-4">
              <div class="badge bg-primary rounded-circle mb-4" style="width:48px;height:48px;line-height:32px;font-size:1.25rem;">3</div>
              <i class="bi bi-check-circle fs-2 text-primary d-block mb-3"></i>
              <h5 class="mb-3">Entregamos</h5>
              <p class="text-muted small mb-0">La entidad beneficiaria recibe la donación y confirma la recepción.</p>
          </div>
      </div>
  </div>
</section>

<!-- Sección de Casos de Éxito / Testimonios + CTA al Mapa -->
<section class="py-5 bg-white">
    <div class="container py-4">
        <div class="text-center mb-5">
            <h2 class="fw-bold mb-2">Historias que transforman realidades</h2>
            <p class="text-muted">Así vive nuestra comunidad la experiencia de donar y recibir con trazabilidad.</p>
        </div>

        <div class="row g-4 justify-content-center mb-5">
            <!-- Testimonio 1: Donante -->
            <div class="col-md-6 col-lg-5">
                <div class="card h-100 shadow-sm border-dark p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-3" style="width: 50px; height: 50px; font-size: 1.1rem;">
                            AG
                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold">Ana Gómez</h5>
                            <span class="text-muted small">Donante Activa</span>
                        </div>
                    </div>
                    <p class="text-muted fst-italic mb-0">
                        <i class="bi bi-quote text-primary fs-4 me-1"></i>
                        "Poder hacer el seguimiento de mis donaciones y ver exactamente a dónde fueron destinadas me da una tranquilidad enorme y me parece súper transparente. El sistema es muy fácil de usar, intuitivo y muy necesario dados los tiempos actuales."
                    </p>
                </div>
            </div>

            <!-- Testimonio 2: Entidad Beneficiaria -->
            <div class="col-md-6 col-lg-5">
                <div class="card h-100 shadow-sm border-dark p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-3" style="width: 50px; height: 50px; font-size: 1.1rem;">
                            CE
                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold">Centro Comunitario Esperanza</h5>
                            <span class="text-muted small">Entidad Beneficiaria</span>
                        </div>
                    </div>
                    <p class="text-muted fst-italic mb-0">
                        <i class="bi bi-quote text-primary fs-4 me-1"></i>
                        "Antes, coordinar las necesidades y las entregas era un desafío constante. Con DonaTrack recibimos los insumos de forma organizada y a tiempo."
                    </p>
                </div>
            </div>
        </div>

        <!-- Llamado a la acción (CTA) hacia el mapa -->
        <div class="text-center pt-4 border-top mx-auto" style="max-width: 650px;">
            <p class="text-dark fw-medium fs-5 mb-3">
                No te quedes con la duda, acá podés ver qué se donó y a dónde fue entregado
            </p>
            <a href="/donaciones/entregadas" class="btn btn-primary px-4 py-2 shadow-sm">
                <i class="bi bi-map me-2"></i>Ver mapa de donaciones entregadas
            </a>
        </div>
    </div>
</section>

<!-- ==================== CTA FINAL ==================== -->
<section class="bg-primary text-white seccion-cta">
    <div class="container text-center">
        <h2 class="fw-bold mb-4">Sumate a la red solidaria</h2>
        <p class="lead mb-5">
            Registrá tu cuenta como persona donante o entidad beneficiaria y empezá a transformar realidades.
        </p>

        <!-- Contenedor responsivo: en mobile se ponen en grilla con espacio, en desktop vuelven a línea -->
        <div class="d-grid gap-2 d-md-block">
            <a href="/registro" class="btn btn-light btn-lg me-md-3">
                <i class="bi bi-person-plus me-2"></i>Crear cuenta
            </a>
            <a href="/login" class="btn btn-outline-light btn-lg">
                <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar sesión
            </a>
        </div>
    </div>
</section>

{{/partial}}
{{>layout}}