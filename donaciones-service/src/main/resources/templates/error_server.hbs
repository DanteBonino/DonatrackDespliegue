{{#partial "contenido"}}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5 text-center">
                        <i class="bi bi-exclamation-triangle fs-1 text-danger mb-3 d-block"></i>
                        <h1 class="h3 mb-2">Algo salió mal de nuestro lado</h1>
                        <p class="text-muted mb-4">{{mensaje}}</p>
                        <div class="d-flex flex-wrap justify-content-center gap-2">
                            <a href="#" onclick="location.reload(); return false;" class="btn btn-outline-primary">
                                <i class="bi bi-arrow-clockwise me-1"></i> Reintentar
                            </a>
                            <a href="/" class="btn btn-primary">
                                <i class="bi bi-house me-1"></i> Ir al inicio
                            </a>
                        </div>
                        <p class="small text-muted mt-4 mb-0">
                            Si el problema continúa, escribinos a
                            <a href="mailto:solidaria@frba.utn.edu.ar">solidaria@frba.utn.edu.ar</a>.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
{{/partial}}
{{>layout}}