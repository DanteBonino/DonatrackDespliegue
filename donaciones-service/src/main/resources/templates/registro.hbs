{{#partial "contenido"}}
    <div class="container py-5">
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">
                <h1 class="fw-bold display-5 mb-3">¿Cómo querés sumarte a DonaTrack?</h1>
                <p class="lead text-muted">Elegí el tipo de perfil con el que te querés registrar para continuar con el proceso.</p>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-3 g-4 justify-content-center">
            {{> partials/registro/opcionTipoUsuario
                    icon="bi-person-heart"
                    color="primary"
                    title="Donante Humano"
                    description="Soy una persona individual que quiere colaborar realizando donaciones de forma directa."
                    url="/registro/donante-humano"
                    btnText="Registrarme como Humano"
            }}

            {{> partials/registro/opcionTipoUsuario
                    icon="bi-building"
                    color="primary"
                    title="Donante Jurídico"
                    description="Represento a una empresa u organización que desea aportar recursos o donaciones corporativas."
                    url="/registro/donante-juridico"
                    btnText="Registrarme como Empresa"
            }}

            {{> partials/registro/opcionTipoUsuario
                    icon="bi-house-heart"
                    color="primary"
                    title="Entidad Beneficiaria"
                    description="Soy una institución que necesita recibir donaciones para la comunidad."
                    url="/registro/entidad-beneficiaria"
                    btnText="Registrar Entidad"
            }}

        </div>

        <!-- Link secundario para los que ya tienen cuenta -->
        <div class="row text-center mt-5">
            <div class="col">
                <p class="text-muted">¿Ya tenés una cuenta? <a href="/login" class="text-decoration-none fw-semibold">Iniciá sesión acá</a></p>
            </div>
        </div>
    </div>
{{/partial}}
{{>layout}}