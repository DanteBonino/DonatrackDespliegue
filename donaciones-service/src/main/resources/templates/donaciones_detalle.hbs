{{#partial "contenido"}}
    <style>
        .foto-ratio { background-color: #f8f9fa; }
        .foto-ratio .ratio { max-height: 24rem; }
        .foto-ratio img { object-fit: contain; }
        .foto-vacia { min-height: 15rem; }
        .carousel-indicators.fuera { position: static; margin: 0; padding: .75rem 0; }

        /* Cuerpo: una columna en móvil, dos desde md */
        .detalle-grid { display: grid; grid-template-columns: 1fr; }
        .detalle-grid > section { padding: 1.5rem; border-top: 1px solid var(--bs-border-color); }

        @media (min-width: 768px) {
            .detalle-grid { grid-template-columns: 1fr 1fr; grid-template-rows: auto auto auto 1fr; }
            .sec-bien   { grid-column: 1; grid-row: 1; }
            .sec-quien  { grid-column: 1; grid-row: 2; }
            .sec-aquien { grid-column: 1; grid-row: 3; }
            .sec-hist   { grid-column: 2; grid-row: 1 / span 4; border-left: 1px solid var(--bs-border-color); }
        }

        /* Historial vertical, el más nuevo arriba */
        .timeline { position: relative; list-style: none; margin: 0; padding-left: 1.75rem; }
        .timeline::before {
            content: ""; position: absolute; left: .6rem; top: .4rem; bottom: .4rem;
            width: 2px; background: #dee2e6;
        }
        .timeline-item { position: relative; padding-bottom: 1.1rem; }
        .timeline-item:last-child { padding-bottom: 0; }
        .timeline-item::before {
            content: ""; position: absolute; left: -1.45rem; top: .35rem;
            width: .8rem; height: .8rem; border-radius: 50%;
            background: #fff; border: 2px solid #adb5bd;
        }
        .timeline-item.actual::before { background: #0d6efd; border-color: #0d6efd; }
    </style>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-8">

                <!-- Cabecera -->
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                    <h1 class="h3 mb-0"><i class="bi bi-box-seam me-2"></i>Detalle de la donación</h1>
                    <a href="#" onclick="history.back(); return false;" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </a>
                </div>

                <div class="card border-0 shadow-sm overflow-hidden">

                    <!-- Fotos -->
                    {{#if tieneFotos}}
                        <div class="foto-ratio">
                            <div id="carrusel-fotos" class="carousel slide carousel-dark" data-bs-interval="false">
                                <div class="carousel-inner">
                                    {{#each fotos}}
                                        <div class="carousel-item {{#if @first}}active{{/if}}">
                                            <div class="ratio ratio-16x9">
                                                <img src="{{this}}" alt="Foto de {{@root.bien}}" class="foto-detalle">
                                            </div>
                                        </div>
                                    {{/each}}
                                </div>

                                {{#if variasFotos}}
                                    <button class="carousel-control-prev" type="button"
                                            data-bs-target="#carrusel-fotos" data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">Foto anterior</span>
                                    </button>
                                    <button class="carousel-control-next" type="button"
                                            data-bs-target="#carrusel-fotos" data-bs-slide="next">
                                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">Foto siguiente</span>
                                    </button>
                                    <div class="carousel-indicators fuera">
                                        {{#each fotos}}
                                            <button type="button" data-bs-target="#carrusel-fotos"
                                                    data-bs-slide-to="{{@index}}"
                                                    class="{{#if @first}}active{{/if}}"
                                                    aria-label="Ir a la foto"></button>
                                        {{/each}}
                                    </div>
                                {{/if}}
                            </div>
                        </div>
                    {{else}}
                        <div class="foto-ratio foto-vacia d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="bi bi-image fs-1 mb-2"></i>
                            <span class="small">Esta donación no tiene fotos</span>
                        </div>
                    {{/if}}

                    <div class="detalle-grid">

                        <!-- Qué se donó -->
                        <section class="sec-bien">
                            <h2 class="h4 fw-bold text-dark mb-1">{{bien}}</h2>
                            <div class="text-muted">{{cantidad}} × {{contenido}} {{unidad}}</div>
                            {{#if vencimiento}}
                                <div class="small text-muted mt-2">
                                    <i class="bi bi-calendar-event me-1"></i>Vence el {{vencimiento}}
                                </div>
                            {{/if}}
                            {{#if estadoDeUso}}
                                <div class="small text-muted mt-2">
                                    <i class="bi bi-tag me-1"></i>Estado de uso: {{estadoDeUso}}
                                </div>
                            {{/if}}
                        </section>

                        <!-- Historial (en móvil queda segundo; en md+ ocupa la columna derecha) -->
                        <section class="sec-hist">
                            <h3 class="h6 text-uppercase text-muted fw-semibold mb-3">Historial de estados</h3>
                            <ul class="timeline">
                                {{#each historial}}
                                    <li class="timeline-item {{#if @first}}actual{{/if}}">
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            {{badgeEstado estado}}
                                            <span class="small text-muted">{{fechaRelativa fecha}}</span>
                                        </div>
                                    </li>
                                {{/each}}
                            </ul>

                            {{#if justificacion}}
                                <div class="alert alert-secondary small mt-3 mb-0">
                                    <strong>Justificación:</strong> {{justificacion}}
                                </div>
                            {{/if}}
                        </section>

                        <!-- Quién -->
                        <section class="sec-quien">
                            <h3 class="h6 text-uppercase text-muted fw-semibold mb-2">Quién lo donó</h3>
                            {{#if donante.esHumano}}
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="badge bg-primary">Persona Física</span>
                                    <strong class="text-dark">{{donante.nombre}} {{donante.apellido}}</strong>
                                </div>
                                {{#if verDocumento}}
                                    <div class="small text-muted mt-2"><strong>DNI:</strong> {{donante.documento}}</div>
                                {{/if}}
                            {{else}}
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="badge bg-dark">{{donante.tipo}}</span>
                                    <strong class="text-dark">{{donante.razonSocial}}</strong>
                                </div>
                                {{#if verDocumento}}
                                    <div class="small text-muted mt-2"><strong>CUIT:</strong> {{donante.cuit}}</div>
                                {{/if}}
                                <div class="small text-muted mt-1"><strong>Rubro:</strong> {{donante.rubro}}</div>
                            {{/if}}
                        </section>

                        <!-- A quién -->
                        <section class="sec-aquien">
                            <h3 class="h6 text-uppercase text-muted fw-semibold mb-2">Asignada a</h3>
                            {{#if estaAsignada}}
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-building text-primary fs-5"></i>
                                    <strong class="text-dark">{{entidad.nombre}}</strong>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-geo-alt me-2 text-muted"></i>
                                    <strong class="text-dark">{{entidad.direccion}}</strong>
                                </div>
                            {{else}}
                                <div class="text-muted small">
                                    <i class="bi bi-hourglass-split me-1"></i>
                                    Todavía no fue asignada a ninguna entidad beneficiaria.
                                </div>
                            {{/if}}
                        </section>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <template id="foto-no-disponible">
        <div class="d-flex flex-column align-items-center justify-content-center text-muted h-100 w-100">
            <i class="bi bi-image fs-1 mb-2"></i>
            <span class="small">No se pudo cargar la foto</span>
        </div>
    </template>

    <script>
        document.querySelectorAll('img.foto-detalle').forEach(img => {
            const reemplazar = () =>
                    img.replaceWith(document.getElementById('foto-no-disponible').content.cloneNode(true));
            img.addEventListener('error', reemplazar, { once: true });
            if (img.complete && img.naturalWidth === 0) reemplazar();
        });
    </script>
{{/partial}}
{{>layout}}