{{#partial "contenido"}}
    <style>
        .foto-ratio { background-color: #f8f9fa; }
        .foto-ratio img { object-fit: contain; }
        .carousel-indicators.fuera { position: static; margin: .75rem 0 0; }

        .timeline { position: relative; list-style: none; margin: 0; padding-left: 1.75rem; }
        .timeline::before {
            content: ""; position: absolute; left: .6rem; top: .4rem; bottom: .4rem;
            width: 2px; background: #dee2e6;
        }
        .timeline-item { position: relative; padding-bottom: 1.1rem; }
        .timeline-item:last-child { padding-bottom: 0; }
        .timeline-item::before {
            content: ""; position: absolute; left: -1.45rem; top: .35rem;
            width: .8rem; height: .8rem; border-radius: 50%;
            background: #fff; border: 2px solid #adb5bd;
        }
        .timeline-item.actual::before { background: #0d6efd; border-color: #0d6efd; }
    </style>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-8">

                <!-- Cabecera -->
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                    <h1 class="h3 mb-0"><i class="bi bi-box-seam me-2"></i>Detalle de la donación</h1>
                    <a href="#" onclick="history.back(); return false;" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </a>
                </div>

                <div class="row g-4 mb-4">

                    <!-- Fotos -->
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body p-3">
                                {{#if tieneFotos}}
                                    <div id="carrusel-fotos" class="carousel slide carousel-dark" data-bs-interval="false">
                                        <div class="carousel-inner rounded">
                                            {{#each fotos}}
                                                <div class="carousel-item {{#if @first}}active{{/if}}">
                                                    <div class="ratio ratio-4x3 foto-ratio">
                                                        <img src="{{this}}" alt="Foto de {{@root.bien}}" class="foto-detalle">
                                                    </div>
                                                </div>
                                            {{/each}}
                                        </div>

                                        {{#if variasFotos}}
                                            <button class="carousel-control-prev" type="button"
                                                    data-bs-target="#carrusel-fotos" data-bs-slide="prev">
                                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                                <span class="visually-hidden">Foto anterior</span>
                                            </button>
                                            <button class="carousel-control-next" type="button"
                                                    data-bs-target="#carrusel-fotos" data-bs-slide="next">
                                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                                <span class="visually-hidden">Foto siguiente</span>
                                            </button>
                                            <div class="carousel-indicators fuera">
                                                {{#each fotos}}
                                                    <button type="button" data-bs-target="#carrusel-fotos"
                                                            data-bs-slide-to="{{@index}}"
                                                            class="{{#if @first}}active{{/if}}"
                                                            aria-label="Ir a la foto"></button>
                                                {{/each}}
                                            </div>
                                        {{/if}}
                                    </div>
                                {{else}}
                                    <div class="ratio ratio-4x3 foto-ratio rounded">
                                        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                                            <i class="bi bi-image fs-1 mb-2"></i>
                                            <span class="small">Esta donación no tiene fotos</span>
                                        </div>
                                    </div>
                                {{/if}}
                            </div>
                        </div>
                    </div>

                    <!-- Estado y contenido -->
                    <div class="col-md-6 d-flex flex-column gap-4">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body p-4">
                                <h2 class="h6 text-uppercase text-muted mb-3">Estado actual</h2>
                                <div class="fs-5">{{badgeEstado estado}}</div>
                            </div>
                        </div>

                        <div class="card border-0 shadow-sm flex-grow-1">
                            <div class="card-body p-4">
                                <h2 class="h6 text-uppercase text-muted mb-3">Qué se donó</h2>
                                <div class="fs-4 fw-bold">{{bien}}</div>
                                <div class="text-muted mb-3">{{cantidad}} × {{contenido}} {{unidad}}</div>

                                <dl class="row mb-0 small">
                                    <dt class="col-6 fw-bold">Cantidad de bultos</dt>
                                    <dd class="col-6 mb-1">{{cantidad}}</dd>

                                    <dt class="col-6 fw-bold">Contenido de cada bulto</dt>
                                    <dd class="col-6 mb-1">{{contenido}} {{unidad}}</dd>

                                    {{#if vencimiento}}
                                        <dt class="col-6 fw-bold">Vencimiento</dt>
                                        <dd class="col-6 mb-1">{{vencimiento}}</dd>
                                    {{/if}}
                                    {{#if estadoDeUso}}
                                        <dt class="col-6 fw-bold">Estado de uso</dt>
                                        <dd class="col-6 mb-1">{{estadoDeUso}}</dd>
                                    {{/if}}
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>

                {{#if puedeVerDetalle}}
                    <div class="row g-4 mb-4">

                        <!-- Donante -->
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body p-4">
                                    <h2 class="h6 text-uppercase text-muted mb-3">Quién lo donó</h2>
                                    {{#if donante.esHumano}}
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <span class="badge bg-primary">Persona Física</span>
                                            <strong>{{donante.nombre}} {{donante.apellido}}</strong>
                                        </div>
                                        {{#if verDocumento}}
                                            <div class="small text-muted mt-1">DNI: {{donante.documento}}</div>
                                        {{/if}}
                                    {{else}}
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <span class="badge bg-dark">{{donante.tipo}}</span>
                                            <strong>{{donante.razonSocial}}</strong>
                                        </div>
                                        {{#if verDocumento}}
                                            <div class="small text-muted mt-1">CUIT: {{donante.cuit}}</div>
                                        {{/if}}
                                        <div class="small text-muted"><strong>Rubro:</strong> {{donante.rubro}}</div>
                                    {{/if}}
                                </div>
                            </div>
                        </div>

                        <!-- Asignación -->
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body p-4">
                                    <h2 class="h6 text-uppercase text-muted mb-3">Asignada a</h2>
                                    {{#if estaAsignada}}
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-building text-primary fs-5"></i>
                                            <strong>{{entidad.nombre}}</strong>
                                        </div>
                                    {{else}}
                                        <div class="text-muted">
                                            <i class="bi bi-hourglass-split me-1"></i>
                                            Todavía no fue asignada a ninguna entidad beneficiaria.
                                        </div>
                                    {{/if}}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Historial -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="h6 text-uppercase text-muted mb-3">Historial de estados</h2>
                            <ul class="timeline">
                                {{#each historial}}
                                    <li class="timeline-item {{#if @first}}actual{{/if}}">
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            {{badgeEstado estado}}
                                            <span class="small text-muted">{{fechaRelativa fecha}}</span>
                                        </div>
                                    </li>
                                {{/each}}
                            </ul>
                        </div>
                    </div>
                {{else}}
                    <div class="alert alert-light border small mb-0">
                        <i class="bi bi-lock me-1"></i>
                        Los datos del donante, la asignación y el historial solo los ven el donante,
                        la entidad receptora y la administración.
                    </div>
                {{/if}}

            </div>
        </div>
    </div>

    <template id="foto-no-disponible">
        <div class="d-flex flex-column align-items-center justify-content-center text-muted">
            <i class="bi bi-image fs-1 mb-2"></i>
            <span class="small">No se pudo cargar la foto</span>
        </div>
    </template>

    <script>
        document.querySelectorAll('img.foto-detalle').forEach(img => {
            const reemplazar = () =>
                    img.replaceWith(document.getElementById('foto-no-disponible').content.cloneNode(true));
            img.addEventListener('error', reemplazar, { once: true });
            if (img.complete && img.naturalWidth === 0) reemplazar();
        });
    </script>
{{/partial}}
{{>layout}}