{{#partial "contenido"}}
    <div class="container py-5">
        <div class="d-flex flex-column flex-md-row justify-content-md-between align-items-start align-items-md-center gap-2 mb-4">
            <h1 class="h2"><i class="bi bi-box-seam me-2"></i>Donaciones Asignadas</h1>
            {{>partials/volverAlPanel}}
        </div>

        {{#if donaciones}}
            <div class="table-responsive shadow-sm rounded bg-white">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th class="ps-4">Bien</th>
                        <th>Cantidad</th>
                        <th>Donante</th>
                        <th>Asignación</th>
                        <th>Estado</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#each donaciones}}
                        <tr>
                            <td class="ps-4 fw-semibold">
                                <i class="bi bi-tag me-1 text-primary"></i>{{this.subCategoria}}
                            </td>

                            <td>{{this.cantidad}} {{this.unidad}}</td>

                            <td>
                                <i class="bi bi-person me-1 text-muted"></i>{{this.donante}}
                            </td>

                            <td class="text-muted small">{{fechaRelativa this.fechaAsignacion}}</td>

                            <td>
                                {{{badgeEstado this.estado}}}
                            </td>
                        </tr>
                    {{/each}}
                    </tbody>
                </table>
            </div>
            <div class="mt-4">
                {{>partials/_contador-paginas nombre="donación"}}
                {{>partials/paginacion}}
            </div>
        {{else}}
            {{>partials/_alerta-vacia mensaje="Todavía no tenés donaciones asignadas."}}
        {{/if}}
    </div>
{{/partial}}
{{>layout}}