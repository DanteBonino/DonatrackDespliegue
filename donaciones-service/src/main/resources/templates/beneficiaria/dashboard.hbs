{{#partial "contenido"}}
    {{#> partials/dashboard-layout tituloPanel="Mi Panel de Entidad Beneficiaria"}}
  {{#if entidad}}
  <div class="alert alert-primary d-flex align-items-center">
    <i class="bi bi-buildings me-2 fs-4"></i>
    <span><strong>{{razonSocial}}</strong></span>
  </div>
  {{else}}
  <div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2"></i>
    No encontramos tu entidad asociada a esta cuenta. Contactá a un administrador.
  </div>
  {{/if}}

  <!-- Tarjetas de resumen -->
  <!-- Resumen -->
  <div class="row g-0 text-center bg-light rounded resumen mb-5">
      <div class="col-12 col-md">
          <i class="bi bi-basket fs-4 text-primary"></i>
          <div class="display-6 fw-bold">{{necesidades}}</div>
          <div class="text-muted small">Necesidades</div>
      </div>
      <div class="col-12 col-md">
          <i class="bi bi-clipboard-check fs-4 text-primary"></i>
          <div class="display-6 fw-bold">{{asignadas}}</div>
          <div class="text-muted small">Asignadas</div>
      </div>
      <div class="col-12 col-md">
          <i class="bi bi-truck fs-4 text-primary"></i>
          <div class="display-6 fw-bold">{{enTraslado}}</div>
          <div class="text-muted small">En Traslado</div>
      </div>
      <div class="col-12 col-md">
          <i class="bi bi-check-circle fs-4 text-primary"></i>
          <div class="display-6 fw-bold">{{entregadas}}</div>
          <div class="text-muted small">Recibidas</div>
      </div>
  </div>

  <!-- Accesos rapidos -->
  {{#> partials/_accesos-rapidos}}
      {{>partials/_acceso-rapido href="/donaciones/asignadas" icono="clipboard"
              titulo="Donaciones Asignadas" descripcion="Ver estado de tus donaciones"}}
      {{>partials/_acceso-rapido href="/necesidades" icono="basket"
              titulo="Necesidades" descripcion="Crear y ver necesidades materiales"}}
      {{>partials/_acceso-rapido href="/guia-necesidades" icono="book" titulo="Ayuda y Guia" descripcion="Ver qué son las necesidades y todo lo relacionado a ellas" }}
  {{/partials/_accesos-rapidos}}
  {{/partials/dashboard-layout}}
{{/partial}}
{{>layout}}