{{#partial "contenido"}}
    {{#> partials/dashboard-layout tituloPanel="Mi Panel de Entidad Beneficiaria"}}
  {{#if entidad}}
  <div class="alert alert-primary d-flex align-items-center">
    <i class="bi bi-buildings me-2 fs-4"></i>
    <span><strong>{{razonSocial}}</strong></span>
  </div>
  {{else}}
  <div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2"></i>
    No encontramos tu entidad asociada a esta cuenta. Contactá a un administrador.
  </div>
  {{/if}}

  <!-- Tarjetas de resumen -->
  <!-- Resumen -->
  <div class="row g-0 text-center bg-light rounded resumen mb-5">
      <div class="col-12 col-md">
          <i class="bi bi-basket fs-4 text-danger"></i>
          <div class="display-6 fw-bold">{{necesidades}}</div>
          <div class="text-muted small">Necesidades</div>
      </div>
      <div class="col-12 col-md">
          <i class="bi bi-box-seam fs-4 text-primary"></i>
          <div class="display-6 fw-bold">{{asignadas}}</div>
          <div class="text-muted small">Asignadas</div>
      </div>
      <div class="col-12 col-md">
          <i class="bi bi-truck fs-4 text-info"></i>
          <div class="display-6 fw-bold">{{enTraslado}}</div>
          <div class="text-muted small">En Traslado</div>
      </div>
      <div class="col-12 col-md">
          <i class="bi bi-check-circle fs-4 text-success"></i>
          <div class="display-6 fw-bold">{{entregadas}}</div>
          <div class="text-muted small">Recibidas</div>
      </div>
  </div>

  <!-- Accesos rapidos -->
  <h5 class="mb-3"><i class="bi bi-lightning me-2"></i>Accesos rápidos</h5>
  <div class="row g-4">
      <div class="col-md-6">
          <a href="/donaciones/asignadas"
             class="card card-link border-primary text-decoration-none h-100">
              <div class="card-body d-flex align-items-center">
                  <i class="bi bi-boxes fs-1 text-primary me-3"></i>
                  <div class="flex-grow-1">
                      <h6 class="mb-1 text-dark">Donaciones Asignadas</h6>
                      <small class="text-muted">Ver estado de tus donaciones</small>
                  </div>
                  <i class="bi bi-arrow-right fs-4 text-primary"></i>
              </div>
          </a>
      </div>
      <div class="col-md-6">
          <a href="/necesidades"
             class="card card-link border-danger text-decoration-none h-100">
              <div class="card-body d-flex align-items-center">
                  <i class="bi bi-basket fs-1 text-danger me-3"></i>
                  <div class="flex-grow-1">
                      <h6 class="mb-1 text-dark">Necesidades</h6>
                      <small class="text-muted">Ver necesidades materiales</small>
                  </div>
                  <i class="bi bi-arrow-right fs-4 text-danger"></i>
              </div>
          </a>
      </div>
  </div>
  {{/partials/dashboard-layout}}
{{/partial}}
{{>layout}}