{{#partial "contenido"}}
    <div class="container py-5">
        <!-- Cabecera ajustada -->
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center mb-4 gap-3">
            <h1 class="h2 mb-0"><i class="bi bi-basket me-2"></i>Necesidades Materiales</h1>

            <!-- Grupo de botones a la derecha -->
            <div class="d-flex flex-wrap gap-2">
                <a href="/guia-necesidades" class="btn btn-outline-primary d-inline-flex align-items-center">
                    <i class="bi bi-book me-1"></i> ¿Qué son las necesidades?
                </a>
                <a href="/necesidades/nueva" class="btn btn-primary d-inline-flex align-items-center shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i> Nueva necesidad
                </a>
            </div>
        </div>

        {{#if necesidades}}
            {{#if mensajeCreada}}
                <div class="alert alert-success alert-dismissible fade show" role="status">
                    <i class="bi bi-check2-circle me-2"></i>
                    <strong>{{mensajeCreada}}</strong>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            {{/if}}

            <div class="table-responsive shadow-sm rounded bg-white">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th class="ps-4">Subcategoría</th>
                        <th>Tipo</th>
                        <th style="min-width: 200px;">Progreso / Recibido</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#each necesidades}}
                        <tr>
                            <!-- Subcategoría (sin ID visible) -->
                            <td class="ps-4 fw-semibold">
                                <i class="bi bi-tag me-1 text-primary"></i>{{this.subCategoria}}
                            </td>

                            <!-- Tipo -->
                            <td>
                                <span class="badge bg-light text-dark border">{{this.tipo}}</span>
                            </td>

                            <!-- Barra porcentual y detalle -->
                            <td>
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>{{this.cantidadRecibida}} / {{this.cantidadRequerida}} {{this.unidad}}</span>
                                    <span>{{this.porcentaje}}%</span>
                                </div>
                                <div class="progress" style="height: 6px;" title="Faltan {{this.faltante}} {{this.unidad}}">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width: {{this.porcentaje}}%;" aria-valuenow="{{this.porcentaje}}" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </td>

                            <!-- Estado -->
                            <td>
                                {{#if this.satisfecha}}
                                    <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">Satisfecha</span>
                                {{else}}
                                    <span class="badge bg-warning bg-opacity-10 text-warning text-dark px-2 py-1">Pendiente</span>
                                {{/if}}
                            </td>

                            <!-- Acciones (Botón de eliminar con el ID oculto por debajo) -->
                            <td class="text-end pe-4">
                                <form action="/necesidades/eliminar" method="POST" class="d-inline" onsubmit="return confirm('¿Estás seguro de que querés eliminar esta necesidad?');">
                                    <input type="hidden" name="id" value="{{this.id}}">
                                    <button type="submit" class="btn btn-outline-danger btn-sm border-0" title="Eliminar necesidad">
                                        <i class="bi bi-trash fs-6"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {{/each}}
                    </tbody>
                </table>
            </div>

            <div class="mt-4">
                {{>partials/_contador-paginas nombre="necesidad"}}
                {{>partials/paginacion}}
            </div>
        {{else}}
            {{>partials/_alerta-vacia mensaje="No tenés necesidades registradas todavía."}}
        {{/if}}
    </div>
{{/partial}}
{{>layout}}