{{#partial "contenido"}}
    <div class="container py-5">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">

            <div class="d-flex flex-wrap align-items-center gap-3">
                <h1 class="h2 mb-0"><i class="bi bi-basket me-2"></i>Necesidades Materiales</h1>
                <a href="/necesidades/nueva" class="btn btn-primary btn-sm d-inline-flex align-items-center">
                    <i class="bi bi-plus-lg me-1"></i> Nueva necesidad
                </a>
            </div>
            <div>
                {{>partials/volverAlPanel}}
            </div>
        </div>

        {{#if necesidades}}
            <div class="table-responsive shadow-sm rounded">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Subcategoría</th>
                        <th>Cantidad requerida</th>
                        <th>Unidad</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#each necesidades}}
                        <tr>
                            <td><code class="text-primary">{{this.id}}</code></td>
                            <td><i class="bi bi-tag me-1 text-primary"></i>{{this.subCategoria}}</td>
                            <td>{{this.cantidadRequerida}}</td>
                            <td>{{this.unidad}}</td>
                            <td>{{this.tipo}}</td>
                            <td>
                                {{#if this.satisfecha}}
                                    <span class="badge bg-success">Satisfecha</span>
                                {{else}}
                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                {{/if}}
                            </td>
                        </tr>
                    {{/each}}
                    </tbody>
                </table>
            </div>
            {{>partials/_contador-paginas nombre="necesidad"}}
            {{>partials/paginacion}}
        {{else}}
            {{>partials/_alerta-vacia mensaje="No tenés necesidades registradas todavía."}}
        {{/if}}
    </div>
{{/partial}}
{{>layout}}