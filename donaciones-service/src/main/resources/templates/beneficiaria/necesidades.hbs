{{#partial "contenido"}}
<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-md-between align-items-start align-items-md-center gap-2 mb-4">
        <h1 class="h2 mb-0"><i class="bi bi-basket me-2"></i>Necesidades Materiales</h1>
        {{>partials/volverAlPanel}}
    </div>

  {{#if necesidades}}
  <div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>ID</th>
          <th>Subcategoría</th>
          <th>Cantidad requerida</th>
          <th>Tipo</th>
          <th>Estado</th>
        </tr>
      </thead>
      <tbody>
        {{#each necesidades}}
        <tr>
          <td><code class="text-primary">{{this.id}}</code></td>
          <td><i class="bi bi-tag me-1 text-primary"></i>{{this.subCategoria}}</td>
          <td>{{this.cantidadRequerida}}</td>
          <td>{{this.tipo}}</td>
          <td>
            {{#if this.satisfecha}}
              <span class="badge bg-success">Satisfecha</span>
            {{else}}
              <span class="badge bg-warning text-dark">Pendiente</span>
            {{/if}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
      {{> partials/indicador_de_elementos_mostrados elementos=necesidades total=paginas.total elementosNombre="necesidad"}}
      {{>partials/paginacion}}
  {{else}}
    {{>partials/_alerta-vacia mensaje="No tenés necesidades registradas todavía."}}
  {{/if}}
</div>
{{/partial}}
{{>layout}}