{{#partial "contenido"}}
    <div class="container py-5">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
            <h1 class="h2 mb-0"><i class="bi bi-archive me-2"></i>Gestión de Depósito</h1>
            <a href="/lotes/nuevo/buscador-de-donantes" class="btn btn-outline-primary d-inline-flex align-items-center">
                <i class="bi bi-plus-lg me-1"></i> Nuevo Lote
            </a>
        </div>

        <p class="text-muted">
            Donaciones disponibles en depósito. Si el bien donado ya no está vigente,
            podés marcar la donación como <strong>VENCIDA</strong>.
        </p>
        {{#if vencidaExito}}
            <div class="alert alert-success">Se pasó a vencida la donación</div>
        {{/if}}
        {{#if hayDonaciones}}
            <div class="table-responsive shadow-sm rounded">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>Bien</th>
                        <th>Cantidad / Detalle</th>
                        <th>Donante</th>
                        <th>Fecha de donación</th>
                        <th>Vigencia del bien</th>
                        <th>Acciones</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#each donaciones}}
                        <tr>
                            <td class="text-capitalize">{{this.bien}}</td>
                            <td>{{this.cantidad}} {{this.unidad}}</td>
                            <td>{{this.donante}}</td>
                            <td>{{fechaRelativa this.fecha}}</td>
                            <td>
                                {{#if this.bienVencido}}
                                    <span class="badge bg-danger">Bien vencido</span>
                                {{else}}
                                    <span class="badge bg-success" title="El bien no venció todavía">Vigente</span>
                                {{/if}}
                            </td>
                            <td>
                                <a href="/donaciones/{{this.id}}/detalle" class="btn btn-sm btn-outline-primary" title="Ver detalle">
                                    <i class="bi bi-eye"></i><span class="visually-hidden">Ver detalle</span>
                                </a>
                                {{#if this.esPerecedero}}
                                    <form method="POST" action="/donaciones/{{this.id}}/vencer">
                                        <button type="submit" class="btn btn-outline-danger btn-sm"
                                                onclick="return confirm('¿Marcar esta donación como vencida?');">
                                            <i class="bi bi-calendar-x me-1"></i>Marcar vencida
                                        </button>
                                    </form>
                                {{/if}}
                            </td>
                        </tr>
                    {{/each}}
                    </tbody>
                </table>
            </div>
            {{>partials/_contador-paginas nombre="donación"}}
            {{>partials/paginacion}}
        {{else}}
            {{>partials/_alerta-vacia mensaje="No hay donaciones en depósito."}}
        {{/if}}
    </div>
{{/partial}}
{{>layout}}