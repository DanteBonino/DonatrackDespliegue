{{#partial "contenido"}}
    {{#> partials/dashboard-layout tituloPanel="Panel de Administración"}}

        <h5 class="text-muted mb-3"><i class="bi bi-box-seam me-2"></i>Donaciones por Estado</h5>
        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="card border-dark shadow-sm h-100">
                    <div class="card-body text-center">
                        <i class="bi bi-archive fs-1 text-dark"></i>
                        <h2 class="display-6 fw-bold mt-2">{{enDeposito}}</h2>
                        <p class="text-muted mb-0">En Depósito</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-secondary shadow-sm h-100">
                    <div class="card-body text-center">
                        <i class="bi bi-hourglass-split fs-1 text-secondary"></i>
                        <h2 class="display-6 fw-bold mt-2">{{pendientesAsignacion}}</h2>
                        <p class="text-muted mb-0">Pendientes de Asignación</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-danger shadow-sm h-100">
                    <div class="card-body text-center">
                        <i class="bi bi-calendar-x fs-1 text-danger"></i>
                        <h2 class="display-6 fw-bold mt-2">{{vencidas}}</h2>
                        <p class="text-muted mb-0">Vencidas</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-success shadow-sm h-100">
                    <div class="card-body text-center">
                        <i class="bi bi-check-circle fs-1 text-success"></i>
                        <h2 class="display-6 fw-bold mt-2">{{entregadas}}</h2>
                        <p class="text-muted mb-0">Entregadas</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Fila 2: Otros estados -->
        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <i class="bi bi-truck fs-2 text-info"></i>
                        <h3 class="fw-bold mt-2">{{enTraslado}}</h3>
                        <p class="text-muted mb-0">En Traslado</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <i class="bi bi-x-circle fs-2 text-danger"></i>
                        <h3 class="fw-bold mt-2">{{entregaFallida}}</h3>
                        <p class="text-muted mb-0">Entregas Fallidas</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <i class="bi bi-people fs-2 text-primary"></i>
                        <h3 class="fw-bold mt-2">{{totalDonantes}}</h3>
                        <p class="text-muted mb-0">Donantes Registrados</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <i class="bi bi-house-heart fs-2 text-success"></i>
                        <h3 class="fw-bold mt-2">{{totalBeneficiarias}}</h3>
                        <p class="text-muted mb-0">Entidades Beneficiarias</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Resumen total + Accesos rápidos -->
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card bg-primary text-white shadow-sm h-100">
                    <div class="card-body text-center">
                        <i class="bi bi-clipboard-data fs-1"></i>
                        <h2 class="display-5 fw-bold mt-2">{{totalDonaciones}}</h2>
                        <p class="mb-0">Total Donaciones en Sistema</p>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title mb-3">
                            <i class="bi bi-lightning me-2"></i>Acciones Rápidas
                        </h5>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <a href="/donaciones/en-deposito" class="btn btn-outline-dark w-100">
                                    <i class="bi bi-archive me-2"></i>Gestionar Depósito
                                </a>
                            </div>
                            <div class="col-md-8">
                                <a href="/donaciones/entregadas" class="btn btn-outline-success w-100">
                                    <i class="bi bi-map me-2"></i>Mapa de donaciones entregadas
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    {{/partials/dashboard-layout}}
{{/partial}}
{{>layout}}