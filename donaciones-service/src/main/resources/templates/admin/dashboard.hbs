{{#partial "contenido"}}
    {{#> partials/dashboard-layout tituloPanel="Panel de Administración"}}

        <h5 class="text-muted mb-3"><i class="bi bi-box-seam me-2"></i>Donaciones por Estado</h5>
        <div class="row g-0 text-center bg-light rounded resumen mb-5">
            <div class="col-12 col-md">
                <i class="bi bi-archive fs-4 text-primary"></i>
                <div class="display-6 fw-bold">{{enDeposito}}</div>
                <div class="text-muted small">En Depósito</div>
            </div>
            <div class="col-12 col-md">
                <i class="bi bi-hourglass-split fs-4 text-primary"></i>
                <div class="display-6 fw-bold">{{pendientesAsignacion}}</div>
                <div class="text-muted small">Pendientes de Asignación</div>
            </div>
            <div class="col-12 col-md">
                <i class="bi bi-truck fs-4 text-primary"></i>
                <div class="display-6 fw-bold">{{enTraslado}}</div>
                <div class="text-muted small">En Traslado</div>
            </div>
            <div class="col-12 col-md">
                <i class="bi bi-check-circle fs-4 text-primary"></i>
                <div class="display-6 fw-bold">{{entregadas}}</div>
                <div class="text-muted small">Entregadas</div>
            </div>
            <div class="col-12 col-md">
                <i class="bi bi-x-circle fs-4 text-primary"></i>
                <div class="display-6 fw-bold">{{entregaFallida}}</div>
                <div class="text-muted small">Entregas Fallidas</div>
            </div>
            <div class="col-12 col-md">
                <i class="bi bi-calendar-x fs-4 text-primary"></i>
                <div class="display-6 fw-bold">{{vencidas}}</div>
                <div class="text-muted small">Vencidas</div>
            </div>
        </div>

        <h5 class="text-muted mb-3"><i class="bi bi-clipboard-data me-2"></i>En el sistema</h5>
        <div class="row g-0 text-center bg-light rounded resumen mb-5">
            <div class="col-12 col-md">
                <i class="bi bi-clipboard-data fs-4 text-primary"></i>
                <div class="display-6 fw-bold">{{totalDonaciones}}</div>
                <div class="text-muted small">Total Donaciones</div>
            </div>
            <div class="col-12 col-md">
                <i class="bi bi-people fs-4 text-primary"></i>
                <div class="display-6 fw-bold">{{totalDonantes}}</div>
                <div class="text-muted small">Donantes Registrados</div>
            </div>
            <div class="col-12 col-md">
                <i class="bi bi-house-heart fs-4 text-primary"></i>
                <div class="display-6 fw-bold">{{totalBeneficiarias}}</div>
                <div class="text-muted small">Entidades Beneficiarias</div>
            </div>
        </div>

        <h5 class="mb-3"><i class="bi bi-lightning me-2"></i>Acciones Rápidas</h5>
        <div class="d-grid gap-3 d-md-flex">
            <a href="/donaciones/en-deposito" class="btn btn-outline-primary">
                <i class="bi bi-archive me-2"></i>Gestionar Depósito
            </a>
            <a href="/donaciones/entregadas" class="btn btn-primary px-4 py-2 shadow-sm">
                <i class="bi bi-map me-2"></i>Mapa de donaciones entregadas
            </a>
        </div>

    {{/partials/dashboard-layout}}
{{/partial}}
{{>layout}}