{{#partial "content"}}
    <div class="container py-4" style="max-width: 560px;">

        <h1 class="h4 mb-1">Nuevo lote</h1>
        <p class="text-muted mb-4">Paso 1 de 2: identificá al donante que entregó los bienes.</p>

        <div class="card">
            <div class="card-body">
                <form method="post" action="/lotes/buscar-donante" novalidate>

                    <label for="q" class="form-label">DNI o CUIT del donante</label>
                    <div class="input-group {{#if error}}has-validation{{/if}}">
                        <input type="text"
                               id="q"
                               name="q"
                               value="{{q}}"
                               class="form-control {{#if error}}is-invalid{{/if}}"
                               placeholder="Ej: 30123456 o 20-30123456-7"
                               inputmode="numeric"
                               autocomplete="off"
                               autofocus
                               required>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search me-1"></i> Buscar
                        </button>
                        {{#if error}}
                            <div class="invalid-feedback">{{error}}</div>
                        {{/if}}
                    </div>

                    <div class="form-text">
                        Podés escribirlo con o sin guiones. Si lo encontramos, pasás a cargar los ítems.
                    </div>
                </form>
            </div>
        </div>

        <div class="mt-3">
            <a href="/lotes" class="text-decoration-none">
                <i class="bi bi-arrow-left"></i> Volver a lotes
            </a>
        </div>

    </div>
{{/partial}}
{{>layout}}