{{#partial "contenido"}}
    <div class="container py-4" style="max-width: 560px;">

        <!-- Breadcrumbs de navegación -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/lotes" class="text-decoration-none">Lotes</a></li>
                <li class="breadcrumb-item active" aria-current="page">Nuevo lote (Paso 1)</li>
            </ol>
        </nav>

        <h1 class="h4 mb-1 fw-bold">Registrar lote</h1>
        <p class="text-muted mb-4 small">Identificá al donante que entregó los bienes para continuar con la carga.</p>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form method="post" action="/lotes/buscar-donante" novalidate>

                    <div class="mb-3">
                        <label for="q" class="form-label fw-semibold">DNI o CUIT del donante <span class="text-danger">*</span></label>
                        <div class="input-group {{#if error}}has-validation{{/if}}">
                            <input type="text"
                                   id="q"
                                   name="q"
                                   value="{{q}}"
                                   class="form-control {{#if error}}is-invalid{{/if}}"
                                   placeholder="Ej: 30123456 o 20301234567"
                                   inputmode="numeric"
                                   autocomplete="off"
                                   autofocus
                                   required>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-search me-1"></i> Buscar
                            </button>
                            {{#if error}}
                                <div class="invalid-feedback">{{error}}</div>
                            {{/if}}
                        </div>
                        <div class="form-text mt-2">
                            Podés escribirlo con o sin guiones. Si el donante existe, el sistema te permitirá avanzar al siguiente paso.
                        </div>
                    </div>

                </form>
            </div>
        </div>

        <div class="mt-3">
            <a href="/lotes" class="text-decoration-none small text-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver al listado de lotes
            </a>
        </div>

    </div>
{{/partial}}
{{>layout}}