{{#partial "contenido"}}
    <style>
        .btn-outline-black-to-blue {
            color: #212529;
            border-color: #212529;
            background-color: transparent;
            transition: all 0.2s ease-in-out;
        }
        .btn-outline-black-to-blue:hover {
            color: #ffffff;
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
        .item-row { scroll-margin-top: 90px; }
    </style>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-10 col-lg-8 col-xl-6">

                <!-- Cabecera -->
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                    <h1 class="h3 mb-0"><i class="bi bi-box-seam me-2"></i>Registrar Lote</h1>
                    <a href="/lotes/nuevo/buscador-de-donantes" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Volver al paso anterior
                    </a>
                </div>

                {{> partials/breadcrumb pasoActual=2}}

                <div class="mb-4">
                    {{> partials/donante-resumen donante}}
                </div>

                <!-- Errores generales que vienen del servidor (ej: lote sin ítems) -->
                {{#if errores}}
                    <div class="alert alert-danger shadow-sm border-0" role="alert">
                        <ul class="mb-0 small">
                            {{#each errores}}<li>{{this}}</li>{{/each}}
                        </ul>
                    </div>
                {{/if}}

                <!-- Resumen de errores por ítem: lo completa el JS si hay filas con errores -->
                <div id="resumen-errores" class="alert alert-danger shadow-sm border-0 d-none" role="alert">
                    <div class="fw-semibold mb-1">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> No se creó el lote: hay campos para corregir.
                    </div>
                    <div class="small">
                        <span id="resumen-errores-texto"></span>
                        Las fotos no se conservan: volvé a adjuntarlas en cada ítem antes de enviar.
                    </div>
                </div>

                <form method="post" action="/lotes/nuevo" enctype="multipart/form-data" id="form-lote" novalidate>
                    <input type="hidden" name="donante" value="{{donanteId}}">

                    <div id="items-container">
                        {{#each filas}}
                            {{> partials/_fila-item this}}
                        {{/each}}
                    </div>

                    <div class="mb-4">
                        <button type="button" id="btn-agregar-item"
                                class="btn btn-outline-black-to-blue w-100 py-2" style="border-style: dashed;">
                            <i class="bi bi-plus-circle me-2"></i> Agregar otro ítem al lote
                        </button>
                        <div class="form-text text-muted text-center mt-2 small">
                            <i class="bi bi-info-circle me-1"></i>
                            Si cargás dos ítems del mismo bien con el mismo vencimiento (perecederos) o el mismo estado de uso (no perecederos),
                            se registran como una sola donación y sus fotos se juntan.
                        </div>
                    </div>

                    <!-- Aviso permanente sobre las fotos -->
                    <div class="alert alert-light border small mb-3">
                        <i class="bi bi-camera me-1"></i>
                        Revisá los datos antes de crear el lote. Si el sistema encuentra errores, vas a tener que
                        <strong>volver a adjuntar las fotos</strong>: el navegador no permite conservarlas.
                    </div>

                    <div class="d-grid">
                        <button type="submit" id="btn-crear-lote"
                                class="p-3 btn btn-primary d-inline-flex justify-content-center align-items-center shadow-sm">
                            <i class="bi bi-check2-circle me-2"></i> Crear lote de donación
                        </button>
                    </div>
                </form>

                <!-- Plantilla limpia para nuevas filas -->
                <template id="plantilla-item">
                    {{> partials/_fila-item plantilla}}
                </template>

            </div>
        </div>
    </div>

    <script>
        const $ = id => document.getElementById(id);
        const container = $('items-container');
        let siguienteIndice = {{siguienteIndice}};

        const MAX_FOTOS = 5;
        const MAX_BYTES = 5 * 1024 * 1024;
        const TIPOS_FOTO = ['image/jpeg', 'image/png', 'image/webp'];

        // ---------- Sincronización de campos según el bien ----------
        function sincronizarFilaItem(fila) {
            const select = fila.querySelector('.subcategoria-select');
            const opcion = select.selectedOptions[0];
            const hayBien = select.value !== '';

            const perecedera = hayBien && opcion.dataset.perecedera === 'true';
            const admiteDecimales = hayBien && opcion.dataset.decimales === 'true';
            const unidad = hayBien ? (opcion.dataset.unidad || '') : '';

            fila.querySelector('.unidad-badge').textContent = unidad || '-';

            const contenido = fila.querySelector('.contenido-input');
            contenido.min = admiteDecimales ? '0.01' : '1';
            contenido.step = admiteDecimales ? '0.01' : '1';
            contenido.inputMode = admiteDecimales ? 'decimal' : 'numeric';

            fila.querySelector('.ayuda-contenido').textContent = !hayBien ? ''
                    : admiteDecimales ? 'Permite decimales (ej: 1.5).' : 'Solo números enteros.';

            // El selector de fecha no deja elegir días pasados
            fila.querySelector('.vencimiento-input').min = new Date().toLocaleDateString('en-CA');

            mostrar(fila.querySelector('.vencimiento-bloque'), hayBien && perecedera);
            mostrar(fila.querySelector('.estado-uso-bloque'), hayBien && !perecedera);
            actualizarResumen(fila);
        }

        // Los campos ocultos se deshabilitan: no se envían. El servidor decide qué validar.
        function mostrar(bloque, visible) {
            bloque.classList.toggle('d-none', !visible);
            bloque.querySelectorAll('input, select').forEach(c => c.disabled = !visible);
        }

        // Línea resumen: "3 × 750 g de Arroz"
        function actualizarResumen(fila) {
            const select = fila.querySelector('.subcategoria-select');
            const contenido = fila.querySelector('.contenido-input').value;
            const cantidad = fila.querySelector('.cantidad-input').value;
            const unidad = fila.querySelector('.unidad-badge').textContent;
            const resumen = fila.querySelector('.resumen-item');
            if (!select.value || !contenido || !cantidad) { resumen.textContent = ''; return; }
            const nombre = select.selectedOptions[0].textContent.trim();
            resumen.textContent = `${cantidad} × ${contenido} ${unidad === '-' ? '' : unidad} de ${nombre}`
                    .replace(/\s+/g, ' ');
        }

        // ---------- utils.Fotos: acumulables, con vista previa y validación en el cliente ----------
        function configurarInputFotos(fila) {
            const input = fila.querySelector('.fotos-input');
            const lista = fila.querySelector('.archivo-preview-list');
            const aviso = fila.querySelector('.fotos-aviso');
            let dt = new DataTransfer();
            let urls = [];

            function avisar(mensajes) {
                aviso.textContent = mensajes.join(' ');
                aviso.classList.toggle('d-none', mensajes.length === 0);
            }

            function pintar() {
                urls.forEach(u => URL.revokeObjectURL(u));
                urls = [];
                lista.replaceChildren();
                Array.from(dt.files).forEach((file, i) => {
                    const url = URL.createObjectURL(file);
                    urls.push(url);

                    const entrada = document.createElement('div');
                    entrada.className = 'd-flex align-items-center gap-2 bg-white border rounded px-2 py-1 small';

                    const img = document.createElement('img');
                    img.src = url; img.alt = ''; img.width = 36; img.height = 36;
                    img.className = 'rounded flex-shrink-0';
                    img.style.objectFit = 'cover';

                    const nombre = document.createElement('span');
                    nombre.className = 'text-truncate flex-grow-1';
                    nombre.textContent = file.name;   // textContent: el nombre del archivo no se interpreta como HTML

                    const quitar = document.createElement('button');
                    quitar.type = 'button';
                    quitar.className = 'btn btn-link btn-sm text-danger p-0 eliminar-foto';
                    quitar.dataset.index = i;
                    quitar.title = 'Quitar foto';
                    quitar.innerHTML = '<i class="bi bi-x-lg"></i>';

                    entrada.append(img, nombre, quitar);
                    lista.appendChild(entrada);
                });
            }

            input.addEventListener('change', () => {
                const mensajes = [];
                Array.from(input.files).forEach(file => {
                    const repetida = Array.from(dt.files).some(f =>
                            f.name === file.name && f.size === file.size && f.lastModified === file.lastModified);
                    if (repetida) return;

                    if (!TIPOS_FOTO.includes(file.type)) {
                        mensajes.push(`"${file.name}" no es JPG, PNG ni WebP.`);
                    } else if (file.size > MAX_BYTES) {
                        mensajes.push(`"${file.name}" supera los 5 MB.`);
                    } else if (dt.files.length >= MAX_FOTOS) {
                        const m = `Máximo ${MAX_FOTOS} fotos por ítem: las demás se descartaron.`;
                        if (!mensajes.includes(m)) mensajes.push(m);
                    } else {
                        dt.items.add(file);
                    }
                });
                input.files = dt.files;
                input.classList.remove('is-invalid');
                avisar(mensajes);
                pintar();
            });

            lista.addEventListener('click', e => {
                const btn = e.target.closest('.eliminar-foto');
                if (!btn) return;
                const quitarIndice = parseInt(btn.dataset.index, 10);
                const nuevo = new DataTransfer();
                Array.from(dt.files).forEach((f, i) => { if (i !== quitarIndice) nuevo.items.add(f); });
                dt = nuevo;
                input.files = dt.files;
                avisar([]);
                pintar();
            });
        }

        // ---------- Filas ----------
        function inicializarFila(fila) {
            fila.querySelectorAll('select[data-valor]').forEach(s => {
                if (s.dataset.valor) s.value = s.dataset.valor;
            });
            sincronizarFilaItem(fila);
            configurarInputFotos(fila);
        }

        function renumerar() {
            const filas = container.querySelectorAll('.item-row');
            filas.forEach((f, i) => f.querySelector('.item-titulo').textContent = `Ítem #${i + 1}`);
            filas.forEach(f => f.querySelector('.btn-eliminar-item').disabled = filas.length === 1);
        }

        container.addEventListener('change', e => {
            if (e.target.classList.contains('subcategoria-select')) {
                sincronizarFilaItem(e.target.closest('.item-row'));
            }
        });

        container.addEventListener('input', e => {
            const fila = e.target.closest('.item-row');
            if (fila) actualizarResumen(fila);
        });

        $('btn-agregar-item').addEventListener('click', () => {
            const html = $('plantilla-item').innerHTML.replaceAll('__INDICE__', siguienteIndice++);
            container.insertAdjacentHTML('beforeend', html);
            const nueva = container.lastElementChild;
            inicializarFila(nueva);
            renumerar();
            nueva.scrollIntoView({ behavior: 'smooth', block: 'start' });
            nueva.querySelector('.subcategoria-select').focus({ preventScroll: true });
        });

        container.addEventListener('click', e => {
            const btn = e.target.closest('.btn-eliminar-item');
            if (btn && container.querySelectorAll('.item-row').length > 1) {
                btn.closest('.item-row').remove();
                renumerar();
            }
        });

        // Enter dentro de un campo no envía el lote entero
        $('form-lote').addEventListener('keydown', e => {
            if (e.key === 'Enter' && e.target.tagName === 'INPUT') e.preventDefault();
        });

        // Evita el doble envío (crearía el lote dos veces)
        const btnEnviar = $('btn-crear-lote');
        const htmlBtnEnviar = btnEnviar.innerHTML;
        $('form-lote').addEventListener('submit', () => {
            btnEnviar.disabled = true;
            btnEnviar.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> Creando lote…';
        });
        // Si el usuario vuelve atrás con el botón del navegador, se restaura
        window.addEventListener('pageshow', e => {
            if (e.persisted) { btnEnviar.disabled = false; btnEnviar.innerHTML = htmlBtnEnviar; }
        });

        // ---------- Arranque ----------
        container.querySelectorAll('.item-row').forEach(inicializarFila);
        renumerar();

        // Si volvió con errores: resumen arriba y scroll al primer ítem con problemas
        (function mostrarResumenDeErrores() {
            const todas = Array.from(container.querySelectorAll('.item-row'));
            const conError = todas.filter(f => f.querySelector('.is-invalid'));
            if (conError.length === 0) return;
            const nums = conError.map(f => '#' + (todas.indexOf(f) + 1)).join(', ');
            $('resumen-errores-texto').textContent =
                    conError.length === 1 ? `Revisá el ítem ${nums}.` : `Revisá los ítems ${nums}.`;
            $('resumen-errores').classList.remove('d-none');
            conError[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
        })();
    </script>
{{/partial}}
{{>layout}}