{{#partial "contenido"}}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-11 col-lg-9 col-xl-8">

                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                    <h1 class="h3 mb-0"><i class="bi bi-box-seam me-2"></i>Registrar Lote de Donación</h1>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4 p-md-5">
                        <!-- Formulario principal con ID para controlar el evento Enter -->
                        <form action="/lotes/crear" method="POST" enctype="multipart/form-data" class="needs-validation" id="form-lote">

                            <!-- Búsqueda de Donante con HTMX -->
                            <div class="card mb-4 bg-light border-0">
                                <div class="card-body p-4">
                                    <label for="input-busqueda-donante" class="form-label fw-bold">Donante (DNI o CUIT) <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="input-busqueda-donante" name="q" placeholder="Ej: 30111222">
                                        <button type="button" class="btn btn-outline-primary"
                                                hx-get="/api/donantes/buscar-fragmento"
                                                hx-include="#input-busqueda-donante"
                                                hx-target="#resultado-donante"
                                                hx-swap="innerHTML">
                                            <i class="bi bi-search me-1"></i> Buscar
                                        </button>
                                    </div>
                                    <div class="form-text">El sistema normalizará automáticamente guiones y espacios.</div>
                                    <div id="resultado-donante" class="mt-3"></div>
                                </div>
                            </div>

                            <h4 class="h5 fw-bold mb-3 text-secondary"><i class="bi bi-basket me-2"></i>Ítems del Lote</h4>

                            <!-- Nota aclaratoria sugerida por la devolución -->
                            <div class="alert alert-info py-2 small mb-4" role="alert">
                                <i class="bi bi-info-circle-fill me-1"></i>
                                <strong>Nota para el administrador:</strong> El sistema agrupará automáticamente en una única donación aquellos ítems cargados que posean exactamente el mismo bien y la misma fecha de vencimiento.
                            </div>

                            <!-- Contenedor de ítems -->
                            <div id="items-container">
                                <!-- Renderizamos la primera fila inicial con índice 0 usando el partial -->
                                {{> partials/_fila-item indice=0}}
                            </div>

                            <!-- Template limpio para clonar filas sin arrastrar estado viejo -->
                            <template id="plantilla-item">
                                {{> partials/_fila-item indice="__INDICE__"}}
                            </template>

                            <!-- Botón Agregar Otro Ítem con estilo dashed correcto -->
                            <div class="mb-4">
                                <button type="button" id="btn-agregar-item" class="btn btn-outline-secondary w-100 py-2" style="border-style: dashed;">
                                    <i class="bi bi-plus-circle me-2"></i> Agregar otro ítem al lote
                                </button>
                            </div>

                            <hr class="my-4">

                            <div class="d-grid">
                                <button type="submit" class="p-3 btn btn-primary d-inline-flex justify-content-center align-items-center shadow-sm">
                                    <i class="bi bi-check-circle me-2"></i> Registrar Lote de Donación
                                </button>
                            </div>

                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Script de control y sincronización -->
    <script>
        const $ = id => document.getElementById(id);
        let siguienteIndice = 1;

        function sincronizarFilaItem(row) {
            const selectSubcat = row.querySelector('.subcategoria-select');
            const opcion = selectSubcat.selectedOptions[0];
            const hayMaterial = opcion && opcion.value !== '';

            const unidad = hayMaterial ? (opcion.dataset.unidad || '') : '';
            const esPerecedera = hayMaterial && opcion.dataset.perecedera === 'true';
            const admiteDecimales = hayMaterial && opcion.dataset.admiteDecimales === 'true';

            row.querySelector('.unidad-badge').textContent = unidad || '-';
            const inputContenido = row.querySelector('.contenido-input');
            inputContenido.step = admiteDecimales ? '0.01' : '1';
            inputContenido.min = admiteDecimales ? '0.01' : '1';
            inputContenido.inputMode = admiteDecimales ? 'decimal' : 'numeric';
            row.querySelector('.ayuda-contenido').textContent = admiteDecimales
                    ? 'Permite decimales (ej: 1.5).'
                    : 'Solo números enteros.';

            const bloqueVencimiento = row.querySelector('.vencimiento-bloque');
            const inputVencimiento = row.querySelector('.vencimiento-input');
            const bloqueEstadoUso = row.querySelector('.estado-uso-bloque');
            const selectEstadoUso = row.querySelector('.estado-uso-input');

            if (esPerecedera) {
                bloqueVencimiento.style.display = 'block';
                inputVencimiento.setAttribute('required', 'required');
                bloqueEstadoUso.style.display = 'none';
                selectEstadoUso.removeAttribute('required');
                selectEstadoUso.value = '';
            } else {
                bloqueVencimiento.style.display = 'none';
                inputVencimiento.removeAttribute('required');
                inputVencimiento.value = '';
                bloqueEstadoUso.style.display = 'block';
                selectEstadoUso.setAttribute('required', 'required');
                if (!selectEstadoUso.value) selectEstadoUso.value = 'NUEVO';
            }

            actualizarEstadoBotonesEliminar();
        }

        function actualizarEstadoBotonesEliminar() {
            const filas = document.querySelectorAll('.item-row');
            filas.forEach((fila, idx) => {
                fila.querySelector('.item-titulo').textContent = `Ítem #${idx + 1}`;
                const btnEliminar = fila.querySelector('.btn-eliminar-item');
                // Deshabilita el botón si solo queda una fila
                btnEliminar.disabled = filas.length === 1;
            });
        }

        // 1. PREVENCIÓN DE ENTER ACCIDENTAL EN INPUTS (Sugerencia clave)
        $('form-lote').addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && e.target.tagName === 'INPUT') {
                e.preventDefault();
            }
        });

        $('items-container').addEventListener('change', function(e) {
            if (e.target.classList.contains('subcategoria-select')) {
                sincronizarFilaItem(e.target.closest('.item-row'));
            }
        });

        // Agregar fila usando el template HTML limpio
        $('btn-agregar-item').addEventListener('click', function() {
            const templateHtml = $('plantilla-item').innerHTML;
            const html = templateHtml.replaceAll('__INDICE__', siguienteIndice++);
            $('items-container').insertAdjacentHTML('beforeend', html);
            const nuevaFila = $('items-container').lastElementChild;
            sincronizarFilaItem(nuevaFila);
        });

        // Eliminar fila
        $('items-container').addEventListener('click', function(e) {
            if (e.target.closest('.btn-eliminar-item')) {
                const fila = e.target.closest('.item-row');
                if (document.querySelectorAll('.item-row').length > 1) {
                    fila.remove();
                    actualizarEstadoBotonesEliminar();
                }
            }
        });

        // Inicializar sincronización de la fila por defecto al cargar
        document.querySelectorAll('.item-row').forEach(sincronizarFilaItem);
    </script>
{{/partial}}
{{>layout}}