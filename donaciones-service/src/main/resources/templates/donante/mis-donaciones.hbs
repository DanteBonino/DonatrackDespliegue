{{#partial "contenido"}}
    <div class="container py-5">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
            <h1 class="h2 mb-0"><i class="bi bi-box-seam me-2"></i>Mis Donaciones</h1>
            {{>partials/volverAlPanel}}
        </div>
        <form method="get" class="row g-2 align-items-end mb-4">
            <div class="col-md-3">
                <label class="form-label small" for="estado">Estado</label>
                <select name="estado" id="estado" class="form-select">
                    <option value="">Todos</option>
                    {{#each filtros.estados}}
                        <option value="{{valor}}" {{#if seleccionado}}selected{{/if}}>{{etiqueta}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small" for="categoria">Categoría</label>
                <select name="categoria" id="categoria" class="form-select">
                    <option value="">Todas</option>
                    {{#each filtros.categorias}}
                        <option value="{{id}}" {{#if seleccionada}}selected{{/if}}>{{nombre}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small" for="subcategoria">Subcategoría</label>
                <select name="subcategoria" id="subcategoria" class="form-select">
                    <option value="">Todas</option>
                    {{#each filtros.categorias}}
                        <optgroup label="{{nombre}}">
                            {{#each subcategorias}}
                                <option value="{{id}}" {{#if seleccionada}}selected{{/if}}>{{nombre}}</option>
                            {{/each}}
                        </optgroup>
                    {{/each}}
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Filtrar</button>
                {{#if hayFiltros}}<a href="?" class="btn btn-outline-secondary">Limpiar</a>{{/if}}
            </div>
        </form>
        {{#if hayDonaciones}}
            <div class="table-responsive shadow-sm rounded">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>Estado</th>
                        <th>Bien</th>
                        <th>Cantidad / Detalle</th>
                        <th>Entidad asignada</th>
                        <th>Fecha</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#each donaciones}}
                        <tr>
                            <td>{{badgeEstado this.estado}}</td>
                            <td class="text-capitalize">{{this.bien}}</td>
                            <td>{{this.cantidad}} {{this.unidad}}</td>
                            <td>{{this.entidad}}</td>
                            <td>{{fechaRelativa this.fecha}}</td>
                        </tr>
                    {{/each}}
                    </tbody>
                </table>
            </div>
            {{>partials/_contador-paginas nombre="donación"}}
            {{> partials/paginacion}}
        {{else}}
            {{>partials/_alerta-vacia mensaje="No se encontraron donaciones con los filtros seleccionados."}}
        {{/if}}
    </div>
{{/partial}}
{{>layout}}