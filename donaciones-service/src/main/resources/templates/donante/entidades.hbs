{{#partial "contenido"}}
<div class="container py-5">
    <div class="flex-column d-flex flex-md-row justify-content-between align-items-center mb-4">
        <h1 class="h2"><i class="bi bi-house-heart me-2"></i>Entidades Beneficiarias</h1>
        {{>partials/volverAlPanel}}
    </div>

    {{#if hayEntidades}}
        <div class="row g-4">
            {{#each entidades}}
                <div class="col-12">
                    <div class="card shadow-sm h-100 border-primary">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="bi bi-building me-2 text-primary"></i>{{this.razonSocial}}
                            </h5>
                            <ul class="list-unstyled small mb-0">
                                <li class="mb-1">
                                    <i class="bi bi-geo-alt me-2 text-muted"></i>{{this.direccion}}
                                </li>
                                <li>
                                    <i class="bi bi-list-check me-2 text-muted"></i>
                                    {{this.cantidadNecesidades}} necesidad(es) activa(s)
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            {{/each}}
        </div>
        <p class="text-muted small mt-3">Mostrando {{entidades.length}} entidad(es).</p>
        {{>partials/paginacion}}
    {{else}}
    {{>partials/_alerta-vacia mensaje="No hay entidades beneficiarias registradas todavía."}}
    {{/if}}
</div>
{{/partial}}
{{>layout}}