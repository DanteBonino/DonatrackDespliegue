{{#partial "contenido"}}
    <div class="container py-5 d-flex justify-content-center">
        <!-- Tarjeta contenedora con sombra y bordes redondeados -->
        <div class="card shadow-sm border-0 rounded-4 p-4 p-md-4 w-100" style="max-width: 480px;">
            <h1 class="h3 mb-4 text-center fw-bold">Iniciar Sesión</h1>

            {{#if registrado}}
                <div class="alert alert-success">{{registrado}}</div>
            {{/if}}
            {{#if error}}
                <div class="alert alert-danger">{{error}}</div>
            {{/if}}

            <form method="POST" action="/login">
                <div class="mb-3">
                    <label class="form-label" for="username">Usuario</label>
                    <input class="form-control" type="text" id="username" name="username" required>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="password">Contraseña</label>
                    <input class="form-control" type="password" id="password" name="password" required>
                </div>
                <button class="btn btn-primary w-100 py-2" type="submit">Ingresar</button>
            </form>

            <p class="text-center mt-3 mb-0 small text-muted">
                ¿No tenés cuenta? <a href="/registro" class="text-decoration-none fw-semibold">Registrate acá</a>
            </p>
        </div>
    </div>
{{/partial}}
{{>layout}}