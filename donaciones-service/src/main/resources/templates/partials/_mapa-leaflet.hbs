<!-- 1. Estilos CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" />

<div id="{{mapaData.mapId}}" style="height: {{mapaData.mapHeight}};" class="rounded border"></div>

<!-- 2. Scripts (el orden importa) -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
<script src="https://unpkg.com/@maplibre/maplibre-gl-leaflet@0.0.22/leaflet-maplibre-gl.js"></script>

<script>
    (function() {
        var southWest = L.latLng(-56.0, -75.0);
        var northEast = L.latLng(-21.0, -53.0);
        var bounds = L.latLngBounds(southWest, northEast);

        var mapa = L.map('{{mapaData.mapId}}', {
            center: [{{mapaData.centerLat}}, {{mapaData.centerLng}}],
            zoom: 5,
            minZoom: 5,
            maxBounds: bounds,
            maxBoundsViscosity: 1.0
        });

        var base = L.maplibreGL({
            style: 'https://tiles.openfreemap.org/styles/liberty'
        }).addTo(mapa);

        var glMap = base.getMaplibreMap();
        glMap.on('load', function () {
            glMap.getStyle().layers.forEach(function (l) {
                if (l.type === 'symbol' && l.layout && l.layout['text-field'] &&  JSON.stringify(l.layout['text-field']).indexOf('name') !== -1) {
                    glMap.setLayoutProperty(l.id, 'text-field',
                            ['coalesce', ['get', 'name:es'], ['get', 'name']]);
                }
            });
        });
        var iconoDonacion = L.divIcon({
            className: 'custom-package-marker',
            html: '<div style="background-color: #0d6efd; color: white; border-radius: 50%; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; box-shadow: 0 3px 6px rgba(0,0,0,0.3); border: 2px solid white;"><i class="fas fa-box" style="font-size: 14px;"></i></div>',
            iconSize: [34, 34],
            iconAnchor: [17, 17],
            popupAnchor: [0, -17]
        });

        var grupo = L.markerClusterGroup();

        {{#each mapaData.marcadores}}
            grupo.addLayer(
                    L.marker([{{this.lat}}, {{this.lng}}], { icon: iconoDonacion })
                            .bindPopup(`<b>{{this.titulo}}</b><br>{{this.descripcion}}`)
            );
        {{/each}}

        mapa.addLayer(grupo);
    })();
</script>