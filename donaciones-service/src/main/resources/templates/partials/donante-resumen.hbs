<div class="alert alert-success mb-0 d-flex align-items-start justify-content-between gap-3" role="alert">
    <div class="d-flex align-items-start">
        <i class="bi bi-check-circle-fill me-2 fs-5 mt-1"></i>
        <div>
            <div class="fw-bold mb-1">Donante verificado</div>
            {{#if esHumano}}
                <span class="badge bg-primary me-1">Persona Física</span>
                <strong>{{nombre}} {{apellido}}</strong>
                <span class="text-muted ms-1">| DNI: {{documento}}</span>
            {{else}}
                <span class="badge bg-dark me-1">{{tipo}}</span>
                <strong>{{razonSocial}}</strong>
                <span class="text-muted ms-1">| CUIT: {{cuit}}</span>
                <div class="small text-muted mt-1"><strong>Rubro:</strong> {{rubro}}</div>
            {{/if}}
        </div>
    </div>
    <a href="/lotes/nuevo" class="btn btn-sm btn-outline-secondary text-nowrap">Cambiar</a>
</div>