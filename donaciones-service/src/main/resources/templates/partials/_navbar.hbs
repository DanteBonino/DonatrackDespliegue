<style>
    .mb-10n { margin-bottom: -0.8rem; }
</style>

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/">DonaTrack</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    {{> partials/navbarLinks/linkConRegistroDeActividad destino="/donaciones/entregadas" textLink="Donaciones entregadas"}}
                </li>
            {{#if sesion}}
                {{#if (esDonante)}}
                    <li class="nav-item">
                        {{> partials/navbarLinks/linkConRegistroDeActividad destino="/mis-donaciones" textLink="Mis Donaciones"}}
                    </li>
                    <li class="nav-item">
                        {{> partials/navbarLinks/linkConRegistroDeActividad destino="/entidades-beneficiarias" textLink="Entidades Beneficiarias"}}
                    </li>
                {{/if}}

                {{#if (esBeneficiaria)}}
                    {{> partials/navbarLinks/linkConRegistroDeActividad destino="/necesidades" textLink="Necesidades"}}
                    {{> partials/navbarLinks/linkConRegistroDeActividad destino="/donaciones/asignadas" textLink="Donaciones Asignadas"}}
                {{/if}}

                {{#if (esAdmin)}}
                    {{> partials/navbarLinks/linkConRegistroDeActividad destino="/donaciones/en-deposito" textLink="Donaciones en Deposito"}}
                {{/if}}
            {{/if}}
            </ul>
            <ul class="navbar-nav ms-auto">
                {{#if sesion}}
                <li class="nav-item">
                    {{> partials/navbarLinks/linkConRegistroDeActividad destino="/dashboard" textLink="Mi panel"}}
                </li>
                <li class="nav-item">
                    <form action="/logout" method="POST" class="d-inline">
                        <button class="btn btn-outline-light btn-sm ms-2 mb-10n">
                            Cerrar sesión ({{sesion.nombreMostrable}})
                        </button>
                    </form>
                </li>
                {{else}}
                <li class="nav-item">
                    {{> partials/navbarLinks/linkConRegistroDeActividad destino="/login" textLink="Iniciar Sesión"}}
                </li>
                <li class="nav-item">
                    {{> partials/navbarLinks/linkConRegistroDeActividad destino="/registro" textLink="Registrarse"}}
                </li>
                {{/if}}
            </ul>
        </div>
    </div>
</nav>