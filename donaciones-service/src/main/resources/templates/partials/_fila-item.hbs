<div class="card border-0 shadow-sm mb-3 item-row" data-indice="{{indice}}">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h6 mb-0 item-titulo">Ítem</h2>
            <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar-item">
                <i class="bi bi-trash me-1"></i> Eliminar
            </button>
        </div>

        <div class="row g-3">
            <div class="col-12">
                <label for="subcategoria-{{indice}}" class="form-label fw-bold">Bien <span class="text-danger">*</span></label>
                <select id="subcategoria-{{indice}}" name="items[{{indice}}][subcategoriaId]"
                        class="form-select subcategoria-select {{#if errores.subcategoriaId}}is-invalid{{/if}}"
                        data-valor="{{valores.subcategoriaId}}">
                    <option value="">Elegí un bien</option>
                    {{#each @root.subcategorias}}
                        <option value="{{idDominio}}"
                                data-perecedera="{{perecedera}}"
                                data-decimales="{{admiteDecimales}}">{{nombre}}</option>
                    {{/each}}
                </select>
                <div class="invalid-feedback">{{errores.subcategoriaId}}</div>
            </div>

            <div class="col-md-6">
                <label for="contenido-{{indice}}" class="form-label fw-bold">Contenido de cada bulto (ej: 750 g) <span class="text-danger">*</span></label>
                <input id="contenido-{{indice}}" type="number" step="any"
                       name="items[{{indice}}][contenido]" value="{{valores.contenido}}"
                       class="form-control contenido-input {{#if errores.contenido}}is-invalid{{/if}}">
                <div class="form-text ayuda-contenido"></div>
                <div class="invalid-feedback">{{errores.contenido}}</div>
            </div>

            <div class="col-md-6">
                <label for="cantidad-{{indice}}" class="form-label fw-bold">Cantidad de bultos iguales (ej: 3) <span class="text-danger">*</span></label>
                <input id="cantidad-{{indice}}" type="number" min="1" step="1"
                       name="items[{{indice}}][cantidad]" value="{{valores.cantidad}}"
                       class="form-control {{#if errores.cantidad}}is-invalid{{/if}}">
                <div class="invalid-feedback">{{errores.cantidad}}</div>
            </div>

            <div class="col-md-6 vencimiento-bloque d-none">
                <label for="vencimiento-{{indice}}" class="form-label fw-bold">Fecha de vencimiento <span class="text-danger">*</span></label>
                <input id="vencimiento-{{indice}}" type="date"
                       name="items[{{indice}}][fechaVencimiento]" value="{{valores.fechaVencimiento}}"
                       class="form-control {{#if errores.fechaVencimiento}}is-invalid{{/if}}">
                <div class="invalid-feedback">{{errores.fechaVencimiento}}</div>
            </div>

            <div class="col-md-6 estado-uso-bloque d-none">
                <label for="estado-{{indice}}" class="form-label fw-bold">Estado de uso <span class="text-danger">*</span></label>
                <select id="estado-{{indice}}" name="items[{{indice}}][estadoUso]"
                        class="form-select {{#if errores.estadoUso}}is-invalid{{/if}}"
                        data-valor="{{valores.estadoUso}}">
                    <option value="">Elegí un estado</option>
                    {{#each @root.estadosUso}}
                        <option value="{{valor}}">{{etiqueta}}</option>
                    {{/each}}
                </select>
                <div class="invalid-feedback">{{errores.estadoUso}}</div>
            </div>

            <div class="col-12">
                <label for="fotos-{{indice}}" class="form-label fw-bold">Fotos</label>
                <input id="fotos-{{indice}}" type="file" multiple
                       accept="image/jpeg,image/png,image/webp"
                       name="items[{{indice}}][fotos]"
                       class="form-control fotos-input {{#if errores.fotos}}is-invalid{{/if}}">
                <div class="archivo-preview-list mt-2 d-flex flex-column gap-1"></div>

                <div class="form-text">Hasta 5 fotos, JPG, PNG o WebP de hasta 5 MB. Podes agregarlas de a una o varias a la vez.</div>
                <div class="invalid-feedback">{{errores.fotos}}</div>
            </div>
        </div>
    </div>
</div>