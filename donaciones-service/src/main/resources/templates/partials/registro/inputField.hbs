<div class="mb-3">
    <label class="form-label text-secondary small fw-bold" for="{{name}}">{{label}}</label>

    <input class="form-control rounded-3 py-2 {{#if error}}is-invalid{{/if}}"
           type="{{#if type}}{{type}}{{else}}text{{/if}}"
           id="{{name}}"
           name="{{name}}"
           value="{{valor}}"
           placeholder="{{placeholder}}"
           {{#if required}}required="required"{{/if}}>

    {{#if error}}
        <div class="invalid-feedback">{{error}}</div>
    {{/if}}
</div>