<a href="{{href}}" class="card card-link border-primary text-decoration-none h-100">
    <div class="card-body d-flex align-items-center">
        <i class="bi bi-{{icono}} fs-1 text-primary me-3"></i>
        <div class="flex-grow-1">
            <h6 class="mb-1 text-dark fw-bold">{{titulo}}</h6>
            <small class="text-muted">{{descripcion}}</small>
        </div>
        <i class="bi bi-arrow-right fs-4 text-primary ms-auto"></i>
    </div>
</a>