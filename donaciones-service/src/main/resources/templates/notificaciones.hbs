{{#partial "contenido"}}
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h2 mb-0"><i class="bi bi-bell me-2"></i>Notificaciones</h1>
            {{>partials/volverAlPanel}}
        </div>

        {{#if mensajeLeida}}
            <div class="alert alert-primary alert-dismissible fade show" role="status">
                <i class="bi bi-check2-circle me-2"></i>
                Se marcó como leída la notificación: <strong>{{mensajeLeida}}</strong>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        {{/if}}

        {{#if hayNotificaciones}}
            <ul class="list-group shadow-sm">
                {{#each notificaciones}}
                    <li class="list-group-item d-flex align-items-start gap-3 {{#unless nueva}}text-muted{{/unless}}">
                        <i class="bi bi-circle-fill text-primary mt-2 {{#unless nueva}}invisible{{/unless}}"
                           style="font-size: .5rem" aria-hidden="true"></i>
                        <span class="{{#if nueva}}fw-semibold{{/if}}">
            {{#if nueva}}<span class="visually-hidden">Nueva: </span>{{/if}}{{this.mensaje}}
          </span>
                        {{#if nueva}}
                            <form method="post" action="{{this.hrefLeer}}" class="ms-auto">
                                <button type="submit" class="btn btn-sm btn-outline-primary">Marcar como leída</button>
                            </form>
                        {{/if}}
                    </li>
                {{/each}}
            </ul>
            {{>partials/_contador-paginas nombre="notificación"}}
            {{>partials/paginacion}}
        {{else}}
            {{>partials/_alerta-vacia mensaje="Todavía no recibiste notificaciones."}}
        {{/if}}
    </div>
{{/partial}}
{{>layout}}