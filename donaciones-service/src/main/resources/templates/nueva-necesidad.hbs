{{#partial "contenido"}}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-10 col-lg-8 col-xl-6">

                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                    <h1 class="h3 mb-0"><i class="bi bi-basket me-2"></i>Registrar Necesidad</h1>
                    <a href="/necesidades" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Ver necesidades
                    </a>
                </div>

                <div class="card border-0 shadow-sm bg-light mb-4">
                    <details>
                        <summary class="py-3 px-3 fw-semibold text-primary small" style="cursor: pointer;">
                            <i class="bi bi-question-circle me-1"></i> ¿Cómo funciona el registro de necesidades? (Guía rápida)
                        </summary>
                        <div class="px-3 pb-3 text-muted small">
                            <p class="mb-2"><strong>1. Bien y cantidad:</strong> Elegí qué bien necesitás e indicá cuánto precisás. El bien determina la unidad de medida.</p>
                            <p class="mb-2"><strong>2. Condición de aceptación:</strong> Para bienes no perecederos podés pedir <em>solo nuevo</em>, <em>solo usado en buen estado</em> o <em>cualquier estado</em>. Para perecederos (por ejemplo, alimentos) no hay distinción de uso: se aceptan mientras no estén vencidos.</p>
                            <p class="mb-2"><strong>3. Tipo:</strong> Una necesidad <em>extraordinaria</em> se registra una sola vez, ya que es puntual. Una <em>recurrente</em> se renueva sola cada cierto tiempo, así no tenés que volver a cargarla.</p>
                            <p class="mb-2"><strong>4. Después de registrarla:</strong> vas a poder seguirla, gestionarla o eliminarla desde <a href="/necesidades">tu lista de necesidades</a>.</p>
                            <p class="mb-0">¿Necesitás más información? Mirá la <a href="/guia-necesidades">guía completa</a>.</p>
                        </div>
                    </details>
                </div>

                <!-- Campos ocultos para recuperar valores anteriores si hubo error de validación -->
                <input type="hidden" id="old-subcategoria" value="{{valores.subcategoriaId}}">
                <input type="hidden" id="old-condicion" value="{{valores.condicion}}">
                <input type="hidden" id="old-tipo" value="{{valores.tipo}}">
                <input type="hidden" id="old-periodo" value="{{valores.periodo}}">

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4 p-md-5">
                        <form action="/necesidades/nueva" method="POST">

                            <!-- Subcategoría -->
                            <div class="mb-4">
                                <label for="subcategoria" class="form-label fw-bold">¿Qué bien necesitás? <span class="text-danger">*</span></label>
                                <select id="subcategoria" name="subcategoriaId" class="form-select {{#if errores.subcategoriaId}}is-invalid{{/if}}" required>
                                    <option value="" selected disabled>Seleccioná el bien que necesitás...</option>
                                    {{#each subcategorias}}
                                        <option value="{{this.id}}"
                                                data-perecedera="{{this.esPerecedera}}"
                                                data-unidad="{{this.unidad}}"
                                                data-admite-decimales="{{this.admiteDecimales}}">
                                            {{this.nombre}}
                                        </option>
                                    {{/each}}
                                </select>
                                {{#if errores.subcategoriaId}}
                                    <div class="invalid-feedback">{{errores.subcategoriaId}}</div>
                                {{/if}}
                            </div>

                            <!-- Cantidad -->
                            <div class="mb-4">
                                <label for="cantidad" class="form-label fw-bold">Cantidad requerida <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="number" step="0.01" min="0.01" id="cantidad" name="cantidad"
                                           class="form-control {{#if errores.cantidad}}is-invalid{{/if}}"
                                           value="{{valores.cantidad}}" placeholder="Ej: 100" aria-describedby="ayuda-cantidad" required>
                                    <span class="input-group-text bg-light text-muted fw-semibold" id="unidad-badge"
                                          style="min-width: 70px; justify-content: center;">-</span>
                                </div>
                                <div class="form-text" id="ayuda-cantidad">La unidad de medida se ajusta según el material seleccionado.</div>
                                {{#if errores.cantidad}}
                                    <div class="text-danger small mt-1">{{errores.cantidad}}</div>
                                {{/if}}
                            </div>

                            <!-- Condición de aceptación -->
                            <fieldset class="mb-4" id="seccion-estado" aria-describedby="texto-descripcion-condicion">
                                <legend class="form-label fw-bold fs-6">Condición de aceptación</legend>
                                <div class="d-flex flex-column flex-md-row gap-3 mt-2">
                                    <div class="form-check">
                                        <input class="form-check-input condicion-radio" type="radio" name="condicion" id="condicionVigente"
                                               value="BASICA" data-desc="Se acepta cualquier estado: nuevo o usado." checked>
                                        <label class="form-check-label" for="condicionVigente">Cualquier estado</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input condicion-radio" type="radio" name="condicion" id="condicionNuevo"
                                               value="NUEVO" data-desc="Solo se acepta producto nuevo, sin uso previo.">
                                        <label class="form-check-label" for="condicionNuevo">Solo nuevo</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input condicion-radio" type="radio" name="condicion" id="condicionUsado"
                                               value="USADO" data-desc="Solo se acepta producto usado en buen estado; no se aceptan nuevos.">
                                        <label class="form-check-label" for="condicionUsado">Solo usado</label>
                                    </div>
                                </div>
                                <div class="form-text mt-2 fst-italic" id="texto-descripcion-condicion" aria-live="polite">
                                    Se acepta cualquier estado: nuevo o usado.
                                </div>
                                <div class="form-text mt-2 text-primary" id="aviso-perecedero">
                                    <i class="bi bi-info-circle me-1"></i> Los productos perecederos no admiten distinción de uso.
                                </div>
                                {{#if errores.condicion}}
                                    <div class="text-danger small mt-1">{{errores.condicion}}</div>
                                {{/if}}
                            </fieldset>

                            <!-- Tipo de necesidad -->
                            <div class="mb-4">
                                <label for="tipoNecesidad" class="form-label fw-bold">Tipo de necesidad</label>
                                <select id="tipoNecesidad" name="tipo" class="form-select {{#if errores.tipo}}is-invalid{{/if}}">
                                    <option value="EXTRAORDINARIA" selected>Extraordinaria (Por esta vez)</option>
                                    <option value="RECURRENTE">Recurrente (Se repite periódicamente)</option>
                                </select>
                                {{#if errores.tipo}}
                                    <div class="invalid-feedback">{{errores.tipo}}</div>
                                {{/if}}
                            </div>

                            <!-- Bloque Periodo -->
                            <div class="mb-4 p-3 bg-light rounded border" id="bloque-periodo">
                                <label for="periodo" class="form-label fw-bold small">Frecuencia de repetición <span class="text-danger">*</span></label>
                                <select id="periodo" name="periodo" class="form-select form-select-sm {{#if errores.periodo}}is-invalid{{/if}}">
                                    <option value="SEMANAL">Semanal</option>
                                    <option value="MENSUAL" selected>Mensual</option>
                                    <option value="BIMESTRAL">Bimestral</option>
                                    <option value="TRIMESTRAL">Trimestral</option>
                                </select>
                                <div class="form-text mt-2">
                                    Definí cada cuánto tiempo se renovará esta necesidad en el sistema.
                                    <span class="text-dark fw-semibold">Si más adelante deja de ser frecuente, podés eliminarla desde <a href="/necesidades">tu lista de necesidades</a>.</span>
                                </div>
                                {{#if errores.periodo}}
                                    <div class="invalid-feedback d-block">{{errores.periodo}}</div>
                                {{/if}}
                            </div>

                            <div class="d-grid mt-4">
                                <button type="submit" class="p-3 btn btn-primary d-inline-flex justify-content-center align-items-center shadow-sm">
                                    <i class="bi bi-check-circle me-2"></i> Registrar Necesidad
                                </button>
                            </div>

                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script>
        const DESC_VIGENTE_NO_PERECEDERO = 'Se acepta cualquier estado: nuevo o usado.';
        const DESC_VIGENTE_PERECEDERO = 'Se acepta mientras no esté vencido.';
        const $ = id => document.getElementById(id);

        function restaurarValoresPrevios() {
            // 1. Subcategoría
            const oldSubCat = $('old-subcategoria')?.value;
            if (oldSubCat) $('subcategoria').value = oldSubCat;

            // 2. Condición (Radio buttons)
            const oldCondicion = $('old-condicion')?.value;
            if (oldCondicion) {
                const radio = document.querySelector(`.condicion-radio[value="${oldCondicion}"]`);
                if (radio && !radio.disabled) radio.checked = true;
            }

            // 3. Tipo de necesidad
            const oldTipo = $('old-tipo')?.value;
            if (oldTipo) $('tipoNecesidad').value = oldTipo;

            // 4. Periodo
            const oldPeriodo = $('old-periodo')?.value;
            if (oldPeriodo) $('periodo').value = oldPeriodo;
        }

        function sincronizarMaterial() {
            const opcion = $('subcategoria').selectedOptions[0];
            const hayMaterial = opcion && opcion.value !== '';
            const unidad = hayMaterial ? (opcion.dataset.unidad || '') : '';
            const esPerecedera = hayMaterial && opcion.dataset.perecedera === 'true';
            const esEntera = hayMaterial && opcion.dataset.admiteDecimales === 'false';

            $('unidad-badge').textContent = unidad || '-';
            $('cantidad').step = esEntera ? '1' : '0.01';
            $('cantidad').min = esEntera ? '1' : '0.01';
            $('cantidad').inputMode = esEntera ? 'numeric' : 'decimal';
            $('ayuda-cantidad').textContent = esEntera
                    ? 'Ingresá una cantidad entera de unidades.'
                    : 'La unidad de medida se ajusta según el material seleccionado.';

            if (esPerecedera) {
                $('condicionVigente').checked = true;
            }
            $('condicionNuevo').disabled = esPerecedera;
            $('condicionUsado').disabled = esPerecedera;
            $('condicionVigente').dataset.desc = esPerecedera ? DESC_VIGENTE_PERECEDERO : DESC_VIGENTE_NO_PERECEDERO;
            $('aviso-perecedero').hidden = !esPerecedera;
            sincronizarDescripcionCondicion();
        }

        function sincronizarDescripcionCondicion() {
            const elegida = document.querySelector('.condicion-radio:checked');
            $('texto-descripcion-condicion').textContent = elegida ? elegida.dataset.desc : '';
        }

        function sincronizarTipo() {
            $('bloque-periodo').hidden = $('tipoNecesidad').value !== 'RECURRENTE';
        }

        $('subcategoria').addEventListener('change', sincronizarMaterial);
        document.querySelectorAll('.condicion-radio').forEach(r =>
                r.addEventListener('change', sincronizarDescripcionCondicion));
        $('tipoNecesidad').addEventListener('change', sincronizarTipo);

        // Inicialización al cargar la página (restaura selecciones y sincroniza el estado visual)
        restaurarValoresPrevios();
        sincronizarMaterial();
        sincronizarTipo();
    </script>
{{/partial}}
{{>layout}}